# Public: safe to ship in the client bundle
PUBLIC_SITE_URL=https://alcusasv.com
PUBLIC_WHATSAPP_NUMBER=50376802410
PUBLIC_GOOGLE_MAPS_LINK=
# mock | wompi. Default and fallback = mock (anything else is treated as mock).
# CI and e2e force "mock". Set to "wompi" only in the build that ships to the
# host whose api/ has the Wompi server variables below (staging first).
PUBLIC_COTIZADOR_MODE=mock

# ---------------------------------------------------------------------------
# Cargar cotizacion por folio (ADR-012, slice F4)
# mock | http. Defecto si se omite: mock en dev/test, http en `astro build`.
# mock = fixtures locales (src/integrations/quotes/mockClient.ts), sin red.
# http = GET /api/quotes/{code} (B6, aun no desplegado). Cuando exista B6 basta
# PUBLIC_QUOTE_API=http. CI y e2e fuerzan mock.
# R4 folio: mock = local contingency folio (L-prefixed); http = POST /api/quote-create.php,
# falling back to the local folio on timeout/5xx. Same name the R5 agent uses.
PUBLIC_QUOTE_API=mock
