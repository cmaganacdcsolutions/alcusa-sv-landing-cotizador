# Public: safe to ship in the client bundle
PUBLIC_SITE_URL=https://alcusasv.com
PUBLIC_WHATSAPP_NUMBER=50376802410
PUBLIC_GOOGLE_MAPS_LINK=
# mock | wompi. Default and fallback = mock (anything else is treated as mock).
# CI and e2e force "mock". Set to "wompi" only in the build that ships to the
# host whose api/ has the Wompi server variables below (staging first).
PUBLIC_COTIZADOR_MODE=mock

# ---------------------------------------------------------------------------
# Server-only: read by api/*.php at runtime. NEVER prefix with PUBLIC_, never
# commit real values. On Hostinger load them from a non-versioned file OUTSIDE
# the webroot (alcusa-private/config.php, see docs/ops/wompi-go-live.md) or
# with SetEnv. Values below are placeholders.
# ---------------------------------------------------------------------------
# panel.wompi.sv > datos del negocio > "App ID" (OAuth client_id)
WOMPI_APP_ID=
# panel.wompi.sv > datos del negocio > "API Secret" (OAuth client_secret AND the
# HMAC key for the webhook wompi_hash and the redirect hash)
WOMPI_API_SECRET=
# Public HTTPS URL Wompi POSTs to, e.g. https://dev.alcusasv.com/api/wompi-webhook.php
WOMPI_WEBHOOK_URL=
# Site origin, no trailing slash, e.g. https://dev.alcusasv.com (redirect + Origin check)
WOMPI_REDIRECT_BASE=

# Optional
WOMPI_CARD_GROUP_ID=                # panel "Grupos de tarjetas": group WITHOUT AMEX
WOMPI_NOTIFY_EMAILS=                # comma separated, notified on successful payments
WOMPI_ACCEPT_TEST_TRANSACTIONS=0    # 1 ONLY on staging: accept esReal=false as approved
WOMPI_MIN_TOTAL=1
WOMPI_MAX_TOTAL=20000
WOMPI_MAX_TRANSPORT=250
WOMPI_DATA_DIR=                     # default: <domain-root>/alcusa-private/data (logs, orders, token cache)
WOMPI_CONFIG_FILE=                  # default: <domain-root>/alcusa-private/config.php
