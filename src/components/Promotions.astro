---
// Promociones del mes (R3). Data-driven: src/content/promotions.json -> promotions.ts.
// Sin promos vigentes la seccion NO se renderiza (0 px, sin gap doble).
// Fidelidad: 02-design/boards/revision-2026-09-29/{ios,android,desktop}-r01 y -r02.
import PhotoFrame from './PhotoFrame';
import {
  discountPct,
  formatUsd,
  getActivePromotions,
  promoHref,
  savings,
  vigenciaLabel,
} from '@content/promotions';

const promos = getActivePromotions();
const count = promos.length;
const single = count === 1;
const title = single ? 'Una oferta que puedes aprovechar hoy' : 'Ofertas que puedes aprovechar hoy';
---

{
  count > 0 && (
    <section id="promociones" class="promos" aria-labelledby="promo-t" data-count={count}>
      <div class="promos__wrap">
        <div class="promos__head">
          <p class="promos__kicker">PROMOCIONES DEL MES</p>
          <div class="promos__title-row">
            <h2 id="promo-t" class="promos__title">
              {title}
            </h2>
            <p class="promos__sub promos__sub--desktop">Precios especiales por tiempo limitado.</p>
            {!single && <p class="promos__sub promos__sub--mobile">Precios especiales por tiempo limitado. Desliza para ver más.</p>}
          </div>
        </div>
        <div class="promos__list" role="list">
          {
            promos.map((p) => {
              const pct = discountPct(p);
              const ahorro = savings(p);
              return (
                <article class="promo-card" role="listitem" data-promo-id={p.id}>
                  <PhotoFrame src={p.image} alt={p.imageAlt} ratio="1/1" className="promo-card__photo">
                    {pct !== null && <span class="promo-card__badge">{`−${pct}%`}</span>}
                  </PhotoFrame>
                  <div class="promo-card__band">
                    <div class="promo-card__band-row">
                      {p.antes !== null ? (
                        <span class="promo-card__antes">
                          <span class="sr-only">Precio anterior </span>
                          <s>{`Antes ${formatUsd(p.antes)}`}</s>
                        </span>
                      ) : (
                        <span class="promo-card__antes">Precio especial</span>
                      )}
                      {ahorro !== null && pct !== null && (
                        <span class="promo-card__ahorras">{`Ahorras ${formatUsd(ahorro)}`}</span>
                      )}
                    </div>
                    <span class="promo-card__ahora">{`Ahora ${formatUsd(p.ahora)}`}</span>
                  </div>
                  <div class="promo-card__body">
                    <div class="promo-card__text">
                      <h3 class="promo-card__title" title={p.title}>
                        {p.title}
                      </h3>
                      <p class="promo-card__desc">{p.description}</p>
                      <span class="promo-card__chip">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="4" y="5.5" width="16" height="14" rx="3" />
                          <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
                        </svg>
                        {vigenciaLabel(p.hasta)}
                      </span>
                    </div>
                    <div class="promo-card__cta-slot">
                      <a class="promo-card__cta" href={promoHref(p)} data-promo-cta>
                        Cotizar esta promo
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  )
}

<style is:global>
  .promos {
    padding-bottom: var(--space-14);
  }
  .promos__head {
    padding: 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .promos__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }
  .promos__title-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .promos__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .promos__sub {
    margin: 0 0 var(--space-2);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .promos__sub--desktop {
    display: none;
  }
  .promos__list {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 var(--space-6) var(--space-3);
    scroll-padding: 0 var(--space-6);
    scrollbar-width: none;
  }
  .promos__list::-webkit-scrollbar {
    display: none;
  }
  .promos[data-count='1'] .promos__list {
    display: block;
    overflow: visible;
    margin-top: var(--space-2);
  }

  .promo-card {
    position: relative;
    flex: 0 0 300px;
    min-width: 0;
    background: var(--color-surface);
    border: 2px solid var(--color-promo);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-promo);
    overflow: hidden;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    transition: box-shadow var(--motion-duration-base) var(--motion-ease-ui);
  }
  .promo-card:hover {
    box-shadow: var(--shadow-promo-hover);
  }
  .promo-card__badge {
    z-index: 2;
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: 12px;
    background: var(--color-promo-badge);
    color: var(--color-ink);
    font-family: var(--font-family-display);
    font-size: 28px;
    font-weight: var(--font-weight-display-semibold);
    line-height: 1.1;
    box-shadow: var(--shadow-promo-badge);
  }
  .promo-card__band {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-promo);
  }
  .promos[data-count='1'] .promo-card__band {
    padding-inline: var(--space-5);
  }
  .promo-card__band-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .promo-card__antes {
    font-size: 14px;
    line-height: 1.5;
    font-weight: var(--font-weight-body-semibold);
    color: var(--color-surface);
  }
  .promo-card__antes s {
    text-decoration-line: line-through;
    text-decoration-thickness: 2px;
  }
  .promo-card__ahorras {
    padding: 2px var(--space-2-5);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-promo-strong);
    font-size: 12px;
    font-weight: var(--font-weight-body-bold);
    line-height: 1.5;
  }
  .promo-card__ahora {
    font-family: var(--font-family-display);
    font-size: 32px;
    font-weight: var(--font-weight-display-semibold);
    line-height: 1.1;
    color: var(--color-surface);
  }
  .promo-card__body {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }
  .promo-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }
  .promo-card__title,
  .promo-card__desc {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .promo-card__title {
    font-size: 17px;
    line-height: 1.3;
    font-weight: var(--font-weight-body-bold);
    color: var(--color-ink);
  }
  .promo-card__desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  .promo-card__chip {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-promo-tint);
    font-size: 12px;
    font-weight: var(--font-weight-body-semibold);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .promo-card__chip svg {
    color: var(--color-promo-strong);
  }
  .promo-card__cta-slot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }
  .promos[data-count='1'] .promo-card__cta-slot {
    padding-top: var(--space-1);
  }
  .promo-card__cta {
    min-height: 52px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--color-primary);
    color: var(--color-surface);
    box-shadow: var(--shadow-md);
    font-size: 16px;
    font-weight: var(--font-weight-body-bold);
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 120ms ease-out,
      box-shadow 120ms ease-out;
  }
  .promo-card__cta:hover,
  .promo-card__cta:active {
    background: var(--color-primary-pressed);
  }
  .promo-card__cta:active {
    box-shadow: none;
  }
  .promo-card__cta:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  /* 768-1279: rejilla de 2 columnas, sin carrusel. */
  @media (min-width: 768px) {
    .promos__wrap {
      width: min(var(--container-page), 100% - 2 * var(--space-10));
      margin-inline: auto;
    }
    .promos__head {
      padding: 0;
    }
    .promos__list,
    .promos[data-count='1'] .promos__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
      overflow: visible;
      padding: 0;
      margin-top: var(--space-6);
      scroll-snap-type: none;
    }
    .promos[data-count='1'] .promos__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .promo-card {
      flex: initial;
    }
  }

  /* Desktop: tipografia y cajas del board desktop-r01/r02. */
  @media (min-width: 1024px) {
    .promos {
      padding-bottom: var(--space-30);
    }
    .promos__head {
      gap: var(--space-4);
    }
    .promos__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .promos__title-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-8);
    }
    .promos__title {
      font-size: 44px;
      line-height: 52px;
      max-width: 760px;
    }
    .promos__sub {
      margin: 0;
      font-size: 18px;
      line-height: 28px;
      max-width: 420px;
    }
    .promos__sub--desktop {
      display: block;
    }
    .promos__sub--mobile {
      display: none;
    }
    .promo-card {
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-promo-lg);
    }
    .promo-card:hover {
      box-shadow: var(--shadow-promo-hover);
    }
    .promo-card__badge {
      top: var(--space-4);
      left: var(--space-4);
      padding: var(--space-1-5) var(--space-4);
      border-radius: 16px;
      font-size: 40px;
      box-shadow: var(--shadow-promo-badge-lg);
    }
    .promo-card__band,
    .promos[data-count='1'] .promo-card__band {
      padding: var(--space-3) var(--space-5);
    }
    .promo-card__band-row {
      gap: var(--space-3);
    }
    .promo-card__antes {
      font-size: 16px;
      line-height: 24px;
    }
    .promo-card__ahorras {
      padding: var(--space-1) var(--space-3-5);
      font-size: 14px;
      line-height: 20px;
    }
    .promo-card__ahora {
      font-size: 44px;
    }
    .promo-card__body {
      padding: var(--space-4) var(--space-5) var(--space-5);
      gap: var(--space-2);
    }
    .promo-card__text {
      gap: var(--space-2);
    }
    .promo-card__title {
      font-size: 22px;
      line-height: 30px;
    }
    .promo-card__desc {
      font-size: 16px;
      line-height: 24px;
    }
    .promo-card__chip {
      gap: var(--space-2);
      padding: var(--space-1-5) var(--space-3-5) var(--space-1-5) var(--space-2-5);
      font-size: 14px;
      line-height: 20px;
    }
    .promo-card__chip svg {
      width: 18px;
      height: 18px;
    }
    .promo-card__cta {
      min-height: 56px;
      font-size: 17px;
    }
  }

  /* >=1280: 3 columnas; 2 promos = 2 columnas; 1 promo = tarjeta horizontal. */
  @media (min-width: 1280px) {
    .promos[data-count='3'] .promos__list,
    .promos:not([data-count='1']):not([data-count='2']) .promos__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .promos[data-count='1'] .promo-card {
      display: grid;
      grid-template-columns: minmax(0, 376px) minmax(0, 1fr) 400px;
      grid-template-rows: 1fr auto auto 1fr;
      height: 380px;
    }
    .promos[data-count='1'] .promo-card::after {
      content: '';
      grid-column: 3;
      grid-row: 1 / -1;
      background: var(--color-promo);
    }
    .promos[data-count='1'] .promo-card__photo {
      grid-column: 1;
      grid-row: 1 / -1;
      width: 376px;
      height: 376px;
    }
    .promos[data-count='1'] .promo-card__body {
      display: contents;
    }
    .promos[data-count='1'] .promo-card__text {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
      min-width: 0;
      padding: var(--space-12) 56px;
      gap: 14px;
    }
    .promos[data-count='1'] .promo-card__title {
      font-family: var(--font-family-display);
      font-weight: var(--font-weight-display-medium);
      font-size: 36px;
      line-height: 44px;
    }
    .promos[data-count='1'] .promo-card__desc {
      max-width: 560px;
      font-size: 18px;
      line-height: 28px;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    .promos[data-count='1'] .promo-card__band {
      grid-column: 3;
      grid-row: 2;
      z-index: 1;
      padding: 0 var(--space-8);
      gap: var(--space-2);
      background: transparent;
    }
    .promos[data-count='1'] .promo-card__antes {
      font-size: 18px;
      line-height: 28px;
    }
    .promos[data-count='1'] .promo-card__ahora {
      font-size: 56px;
    }
    .promos[data-count='1'] .promo-card__cta-slot {
      grid-column: 3;
      grid-row: 3;
      z-index: 1;
      padding: var(--space-3) var(--space-8) 0;
      margin: 0;
    }
    .promos[data-count='1'] .promo-card__cta {
      background: var(--color-surface);
      color: var(--color-promo-strong);
      box-shadow: none;
    }
    .promos[data-count='1'] .promo-card__cta:hover {
      background: var(--color-promo-tint);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-card,
    .promo-card__cta {
      transition: none;
    }
  }
</style>
