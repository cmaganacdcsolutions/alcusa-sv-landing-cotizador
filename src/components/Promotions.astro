---
// Promociones del mes (R3). Data-driven: src/content/promotions.json -> promotions.ts.
// La seccion SIEMPRE existe en el DOM: sin promos vigentes en build queda `hidden` (0 px, sin gap doble) y el script
// de runtime (promotionsRuntime.ts, ADR-014 A5) puede llenarla o ocultarla con lo que publique el admin.
// Este HTML horneado es el respaldo (SEO, sin JS, falla del fetch).
// Pulido 2026-10-06: tarjetas compactas a escala de las del catalogo (3 por fila en escritorio, carrusel con
// snap en movil), mismo contenedor de 1240 px que las secciones del catalogo. El flyer (9:16, con precio y letra
// chica impresos) se ve COMPLETO en un marco 4:5 (contain): ~265 px de flyer legible en una tarjeta de ~376.
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import PhotoFrame from './PhotoFrame';
import {
  discountPct,
  formatUsd,
  getActivePromotions,
  PROMOS_COPY,
  PROMO_IMAGE_SIZES,
  promoHref,
  promoImageSrcSet,
  promosTitle,
  savings,
  vigenciaLabel,
} from '@content/promotions';

const promos = getActivePromotions();
const count = promos.length;
const single = count === 1;
const title = promosTitle(count);

// Ancho/alto REALES del flyer (algunas fuentes solo dan 720x1280): el srcset y width/height no declaran pixeles
// que no existen. Solo archivos de /images/promos (build, en public/); otro origen cae al default 900x1600 (9:16).
async function flyerSize(image: string): Promise<{ w: number; h: number }> {
  const file = new URL(`../../public${image}`, import.meta.url);
  if (image.startsWith('/images/promos/') && existsSync(file)) {
    const { width, height } = await sharp(fileURLToPath(file)).metadata();
    if (width && height) return { w: width, h: height };
  }
  return { w: 900, h: 1600 };
}
const sizes = await Promise.all(promos.map((p) => flyerSize(p.image)));
---

<section id="promociones" class="promos" aria-labelledby="promo-t" data-count={count} hidden={count === 0}>
  <div class="promos__wrap">
    <div class="promos__head">
      <p class="promos__kicker">{PROMOS_COPY.kicker}</p>
      <div class="promos__title-row">
        <h2 id="promo-t" class="promos__title title-gradient">
          {title}
        </h2>
        <p class="promos__sub promos__sub--desktop">{PROMOS_COPY.sub}</p>
        {!single && <p class="promos__sub promos__sub--mobile">{PROMOS_COPY.subMobileMany}</p>}
      </div>
    </div>
    <div class="promos__list" role="list">
      {
        promos.map((p, i) => {
          const pct = discountPct(p);
          const ahorro = savings(p);
          return (
            <article class="promo-card" role="listitem" data-promo-id={p.id}>
              {/* Flyer oficial 9:16 (texto y precio incrustados): contain + capa ambiental = foto completa, sin recorte. */}
              <PhotoFrame
                src={p.image}
                srcSet={promoImageSrcSet(p.image, sizes[i].w)}
                sizes={PROMO_IMAGE_SIZES}
                alt={p.imageAlt}
                width={sizes[i].w}
                height={sizes[i].h}
                ratio="4/5"
                className="promo-card__photo"
              >
                {pct !== null && <span class="promo-card__badge">{`−${pct}%`}</span>}
              </PhotoFrame>
              <div class="promo-card__band">
                <div class="promo-card__band-row">
                  {p.antes !== null ? (
                    <span class="promo-card__antes">
                      <span class="sr-only">Precio anterior </span>
                      <s>{`Antes ${formatUsd(p.antes)}`}</s>
                    </span>
                  ) : (
                    <span class="promo-card__antes">Precio especial</span>
                  )}
                  {ahorro !== null && pct !== null && (
                    <span class="promo-card__ahorras">{`Ahorras ${formatUsd(ahorro)}`}</span>
                  )}
                </div>
                <span class="promo-card__ahora">{`Ahora ${formatUsd(p.ahora)}`}</span>
              </div>
              <div class="promo-card__body">
                <div class="promo-card__text">
                  <h3 class="promo-card__title" title={p.title}>
                    {p.title}
                  </h3>
                  <p class="promo-card__desc">{p.description}</p>
                  {p.rules.length > 0 && (
                    <ul class="promo-card__rules">
                      {p.rules.map((r) => (
                        <li>{r}</li>
                      ))}
                    </ul>
                  )}
                  <span class="promo-card__chip">
                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="4" y="5.5" width="16" height="14" rx="3" />
                      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
                    </svg>
                    {vigenciaLabel(p.hasta)}
                  </span>
                </div>
                <div class="promo-card__cta-slot">
                  <a class="promo-card__cta" href={promoHref(p)} data-promo-cta>
                    Cotizar esta promo
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { initPromotionsRuntime } from './promotionsRuntime';

  void initPromotionsRuntime();
</script>

<style is:global>
  /* Mismo contenedor que .csec (catalogo): 1240 px con 16/24/32 px de aire lateral. */
  .promos {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }
  .promos__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .promos__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    color: var(--color-accent-on-dark);
  }
  .promos__title-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .promos__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-bold);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-text-on-dark);
    text-wrap: balance;
  }
  .promos__sub {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-on-dark-muted);
  }
  .promos__sub--desktop {
    display: none;
  }

  /* Movil / tablet: carrusel con snap; la tarjeta (88% del ancho, tope 360 px) deja asomar la siguiente. */
  .promos__list {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    margin: var(--space-4) calc(-1 * var(--space-4)) 0;
    padding: 0 var(--space-4) var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    scrollbar-width: none;
  }
  .promos__list::-webkit-scrollbar {
    display: none;
  }
  .promos[data-count='1'] .promos__list {
    display: block;
    overflow: visible;
    margin-inline: 0;
    padding-inline: 0;
  }

  /* Tarjeta: misma familia que .pcard (clara sobre noche, radio-lg, borde suave). */
  .promo-card {
    position: relative;
    display: flex;
    flex: 0 0 min(88vw, 360px);
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-nav);
    scroll-snap-align: start;
  }
  .promos[data-count='1'] .promo-card {
    max-width: 360px;
  }
  .promo-card * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .promo-card__badge {
    z-index: 2;
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-promo-badge);
    color: var(--color-ink);
    font-family: var(--font-family-display);
    font-size: 20px;
    font-weight: var(--font-weight-display-semibold);
    line-height: 1.2;
    box-shadow: var(--shadow-promo-badge);
  }

  /* Fila de precio sobre la card blanca (sin franja de color): antes/ahorras a la izquierda, ahora (azul de marca) a la derecha. */
  .promo-card__band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-2);
    row-gap: 2px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
  }
  .promo-card__band-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px var(--space-2);
  }
  .promo-card__antes {
    font-size: 13px;
    line-height: 1.4;
    font-weight: var(--font-weight-body-semibold);
    color: var(--color-ink-muted);
  }
  .promo-card__antes s {
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
  }
  .promo-card__ahorras {
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-promo-tint);
    color: var(--color-promo-strong);
    font-size: 11px;
    font-weight: var(--font-weight-body-bold);
    line-height: 1.6;
  }
  .promo-card__ahora {
    font-family: var(--font-family-display);
    font-size: 24px;
    font-weight: var(--font-weight-display-semibold);
    line-height: 1.15;
    color: var(--color-primary);
  }

  .promo-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
  }
  .promo-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .promo-card__title,
  .promo-card__desc {
    margin: 0;
  }
  /* Titulo: maximo 2 lineas (title= lleva el texto completo). La descripcion NO se recorta. */
  .promo-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1.3;
    font-weight: var(--font-weight-body-bold);
    color: var(--color-ink);
  }
  .promo-card__desc {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .promo-card__rules {
    margin: 0;
    padding-left: var(--space-4);
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .promo-card__chip {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-3) 2px var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-promo-tint);
    font-size: 12px;
    font-weight: var(--font-weight-body-semibold);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .promo-card__chip svg {
    flex: none;
    color: var(--color-promo-strong);
  }
  .promo-card__cta-slot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }

  /* CTA: pastilla de 44 px como la del navbar; sobre tarjeta clara = azul primario. */
  .promo-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-4);
    white-space: nowrap;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-surface);
    font-size: 14px;
    font-weight: var(--font-weight-body-bold);
    line-height: 20px;
    text-decoration: none;
  }
  .promo-card__cta svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .promo-card__cta:active {
    background: var(--color-primary-active);
  }
  .promo-card__cta:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  /* Hover = receta del navbar: relleno suave, sin elevacion ni sombra. */
  @media (hover: hover) and (pointer: fine) {
    .promo-card__cta {
      transition:
        background-color var(--hover-dur, 160ms) var(--hover-ease, cubic-bezier(0.2, 0.8, 0.2, 1)),
        color var(--hover-dur, 160ms) var(--hover-ease, cubic-bezier(0.2, 0.8, 0.2, 1));
    }
    .promo-card__cta:hover {
      background: var(--color-accent);
    }
    .promo-card__cta:active {
      background: var(--color-primary-active);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .promo-card__cta {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .promos {
      padding-inline: var(--space-6);
    }
    .promos__list {
      margin-inline: calc(-1 * var(--space-6));
      padding-inline: var(--space-6);
      scroll-padding-inline: var(--space-6);
    }
    .promos[data-count='1'] .promos__list {
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  /* >=900: rejilla de 3 columnas (1 o 2 promos = 1 o 2 columnas de 376 px, alineadas a la izquierda). */
  @media (min-width: 900px) {
    .promos__list,
    .promos[data-count='1'] .promos__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      margin-inline: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
    .promos[data-count='1'] .promos__list {
      grid-template-columns: minmax(0, 376px);
    }
    .promos[data-count='2'] .promos__list {
      grid-template-columns: repeat(2, minmax(0, 376px));
    }
    .promo-card,
    .promos[data-count='1'] .promo-card {
      flex: initial;
      max-width: none;
    }
    .promos__sub--desktop {
      display: block;
    }
    .promos__sub--mobile {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .promos {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-16);
    }
    .promos__head {
      gap: var(--space-4);
    }
    .promos__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .promos__title-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-8);
    }
    .promos__title {
      font-size: 44px;
      line-height: 52px;
      max-width: 760px;
    }
    .promos__sub {
      font-size: 16px;
      line-height: 24px;
      max-width: 420px;
    }
    .promos__list,
    .promos[data-count='1'] .promos__list {
      margin-top: var(--space-6);
      gap: var(--space-6);
    }
    .promo-card__badge {
      font-size: 22px;
    }
  }
</style>
