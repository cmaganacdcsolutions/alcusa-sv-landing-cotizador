---
// Drawer — static markup + a small vanilla-JS toggle script (open/close,
// focus trap, Esc, veil click, back-button close). No pricing/cart state,
// no hardcoded wa.me (README §4) — WhatsApp link built via integrations/.
//
// Fidelity source: 02-design/boards/{desktop,ios,android}-02-drawer-open.dc.html.
// Section icons + the "Síguenos"/contacts/location block only render on the
// desktop board (>= --breakpoint-lg); the two mobile boards draw the same nav
// list with no icons and no contacts/location block, so those pieces are
// desktop-only here too (see the `@media (min-width: 1024px)` rules below).
//
// Nav label note: the boards read "Galería" for that link; this repo already
// ships "Proyectos reales" for the same #galeria destination consistently in
// Footer.astro, Galeria.astro and their tests (sf-fixes.spec.ts, contacto.spec.ts).
// Kept the established site copy here instead of forking the wording between
// the drawer and the footer nav — flagged in the HANDOFF.
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isContact = pathname === '/contacto';
---

<div id="drawer-veil" class="drawer-veil" hidden></div>
<nav
  id="drawer-panel"
  class="drawer"
  aria-label="Menú principal"
  aria-hidden="true"
  inert
  data-drawer-panel
>
  <div class="drawer__head">
    <a href="/" class="drawer__brand" aria-label="ALCUSA, inicio">
      <img
        src="/images/logo-primary.png"
        alt="ALCUSA · Disfrutar con calidad"
        width="144"
        height="81"
        class="drawer__brand-img"
      />
    </a>
    <button type="button" id="drawer-close-btn" class="drawer__close" aria-label="Cerrar menú">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>

  <div class="drawer__links">
    <a
      href="/#inicio"
      data-drawer-link
      class="drawer__link"
      aria-current={isHome ? 'page' : undefined}
    >
      <span class="drawer__link-icon" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><path d="M4 11l8-6.5 8 6.5M6 9.5v10h12v-10"></path></svg
        ></span
      >Inicio</a
    >
    <a href="/#modelos" data-drawer-link class="drawer__link">
      <span class="drawer__link-icon" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect
            x="13"
            y="4"
            width="7"
            height="7"
            rx="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5"></rect><rect
            x="13"
            y="13"
            width="7"
            height="7"
            rx="1.5"></rect></svg
        ></span
      >Catálogo</a
    >
    <a href="/#proceso" data-drawer-link class="drawer__link">
      <span class="drawer__link-icon" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><path d="M9 6.5h11M9 12h11M9 17.5h11"></path><circle cx="4.8" cy="6.5" r="1.3"
          ></circle><circle cx="4.8" cy="12" r="1.3"></circle><circle cx="4.8" cy="17.5" r="1.3"
          ></circle></svg
        ></span
      >Cómo funciona</a
    >
    <a href="/#galeria" data-drawer-link class="drawer__link">
      <span class="drawer__link-icon" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><rect x="3.5" y="4.5" width="17" height="15" rx="3"></rect><circle
            cx="9"
            cy="9.5"
            r="1.8"></circle><path d="M4 17l4.5-4.5 3.5 3.5 2.5-2.5L20 18"></path></svg
        ></span
      >Proyectos reales</a
    >
    <a href="/cotizador" data-drawer-link class="drawer__link drawer__link--pill">
      <span class="drawer__link-icon drawer__link-icon--pill" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><rect x="5" y="3.5" width="14" height="17" rx="2.5"></rect><path
            d="M8.5 7.5h7M8.5 12h1M12 12h1M15 12h.5M8.5 16h1M12 16h1M15 16h.5"
          ></path></svg
        ></span
      ><span class="drawer__link-label">Cotizar</span>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </a>
    <a
      href="/contacto"
      data-drawer-link
      class="drawer__link"
      aria-current={isContact ? 'page' : undefined}
    >
      <span class="drawer__link-icon" aria-hidden="true"
        ><svg width="22" height="22" viewBox="0 0 24 24"
          ><path d="M4.5 5.5h15v10h-8l-4.5 3.5v-3.5h-2.5z"></path></svg
        ></span
      >Contacto</a
    >
  </div>

  <div class="drawer__footer">
    <a href={waHref} class="drawer__whatsapp">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z"></path><path
          d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z"
        ></path></svg
      >
      WhatsApp · 7680-2410
    </a>

    <div class="drawer__contacts">
      <span class="drawer__contacts-row"
        ><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            d="M6.5 3.5h3l1.5 4-2 1.2a11 11 0 0 0 6.3 6.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"
          ></path></svg
        >2278-2460 · 2208-4101 · 2563-7742</span
      >
      <span class="drawer__contacts-row"
        ><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"></path><circle
            cx="12"
            cy="10"
            r="2.3"></circle></svg
        >Calle El Pedregal, Ciudad Merliot</span
      >
    </div>

    <div class="drawer__follow">
      <span class="drawer__follow-label">Síguenos</span>
      <div class="drawer__social">
        <a href="https://instagram.com/alcusasv" aria-label="Instagram @alcusasv" class="drawer__social-icon"
          ><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
            ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"
            ></circle><circle cx="17.2" cy="6.8" r=".6"></circle></svg
          ></a
        >
        <a href="https://tiktok.com/@alcusaes" aria-label="TikTok @alcusaes" class="drawer__social-icon"
          ><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M14 4c.4 2.6 2.2 4.3 5 4.5"
            ></path></svg
          ></a
        >
        <a
          href="https://youtube.com/@alcusaelsalvador8209"
          aria-label="YouTube @alcusaelsalvador8209"
          class="drawer__social-icon"
          ><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
            ><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10.5 9.5v5l4.3-2.5z"
            ></path></svg
          ></a
        >
      </div>
    </div>
  </div>
</nav>

<style>
  .drawer-veil {
    position: fixed;
    inset: 0;
    background: var(--color-scrim-ink);
    z-index: 40;
  }

  .drawer {
    position: fixed;
    left: 0;
    top: 0;
    height: 100dvh;
    width: min(360px, 83vw);
    background: var(--color-surface);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    box-shadow: var(--shadow-lg);
    padding: max(var(--space-6), env(safe-area-inset-top)) var(--space-5)
      max(var(--space-8), env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    z-index: 50;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(-100%);
    transition: transform var(--motion-duration-base) var(--motion-ease-ui);
  }

  .drawer[data-open='true'] {
    transform: translateX(0);
  }

  .drawer-veil[data-open='true'] {
    display: block;
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer__brand {
    display: block;
    line-height: 0;
  }

  .drawer__brand-img {
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
  }

  .drawer__close {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .drawer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .drawer__link {
    min-height: 48px;
    padding: 0 var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-body-medium);
    text-decoration: none;
  }

  .drawer__link[aria-current='page'] {
    background: var(--color-surface-tint);
    color: var(--color-primary);
    font-weight: var(--font-weight-body-bold);
  }

  .drawer__link-icon {
    display: none;
    color: var(--color-ink-muted);
    flex-shrink: 0;
  }

  .drawer__link-icon svg {
    stroke: currentColor;
  }

  .drawer__link[aria-current='page'] .drawer__link-icon {
    color: var(--color-primary);
  }

  .drawer__link--pill {
    margin: var(--space-2) 0;
    min-height: 52px;
    padding: 0 var(--space-5);
    justify-content: space-between;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: var(--font-weight-body-bold);
    box-shadow: var(--shadow-md);
  }

  .drawer__link--pill .drawer__link-icon--pill {
    color: var(--color-surface);
  }

  .drawer__link-label {
    flex-grow: 1;
  }

  .drawer__footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .drawer__whatsapp {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .drawer__contacts {
    display: none;
  }

  .drawer__follow {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer__follow-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .drawer__social {
    display: flex;
    gap: var(--space-2);
  }

  .drawer__social-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-surface-tint);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .drawer {
      width: 440px;
      border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
      /* Board-drawn value (desktop-02-drawer-open.dc.html:82) — stronger than
         --shadow-lg (which the two mobile boards use verbatim). */
      box-shadow: 0 24px 60px rgba(16, 33, 61, 0.22);
      padding: var(--space-6) var(--space-10) var(--space-10);
      gap: var(--space-6);
    }

    .drawer__brand-img {
      width: 160px;
      height: 90px;
    }

    .drawer__close {
      width: 48px;
      height: 48px;
    }

    .drawer__close svg {
      width: 22px;
      height: 22px;
    }

    .drawer__link {
      min-height: 56px;
      padding: 0 var(--space-4);
      border-radius: var(--radius-md);
      font-size: 1.125rem;
      font-weight: var(--font-weight-body-bold);
    }

    .drawer__link:not([aria-current='page']) {
      font-weight: 600;
    }

    .drawer__link-icon {
      display: flex;
      align-items: center;
    }

    .drawer__link--pill {
      min-height: 60px;
      padding: 0 var(--space-5) 0 var(--space-4);
      /* Board-drawn value (desktop-02-drawer-open.dc.html:92) — primary-tinted,
         distinct from --shadow-md. */
      box-shadow: 0 8px 20px rgba(7, 59, 146, 0.22);
    }

    .drawer__footer {
      gap: var(--space-5);
      padding-top: var(--space-6);
    }

    .drawer__whatsapp {
      min-height: 56px;
      gap: 10px;
      font-size: 1.0625rem;
      font-weight: var(--font-weight-body-bold);
    }

    .drawer__contacts {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--color-ink-muted);
    }

    .drawer__contacts-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .drawer__contacts-row svg {
      stroke: currentColor;
      flex-shrink: 0;
    }

    .drawer__follow-label {
      font-size: 0.9375rem;
      font-weight: var(--font-weight-body-bold);
    }

    .drawer__social {
      gap: 10px;
    }

    .drawer__social-icon {
      width: 48px;
      height: 48px;
      border: 1px solid var(--color-surface-tint);
    }
  }

  /* Short-viewport compaction (laptops at 768–900px tall): shrink the
     brand mark, link rows and footer spacing so the whole drawer —
     including "Síguenos" — fits without scrolling. Scrolling (above) is
     the last-resort fallback for anything shorter than this. */
  @media (min-width: 1024px) and (max-height: 920px) {
    .drawer {
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
      gap: var(--space-4);
    }

    .drawer__brand-img {
      width: 120px;
      height: 68px;
    }

    .drawer__links {
      gap: 2px;
    }

    .drawer__link {
      min-height: 44px;
    }

    .drawer__link--pill {
      min-height: 48px;
      margin: var(--space-1) 0;
    }

    .drawer__footer {
      gap: var(--space-3);
      padding-top: var(--space-4);
    }

    .drawer__whatsapp {
      min-height: 44px;
    }

    .drawer__social-icon {
      width: 40px;
      height: 40px;
    }
  }

  /* Same idea for narrow (<1024px) short viewports — mobile landscape
     phones and small tablets in landscape. */
  @media (max-width: 1023.98px) and (max-height: 700px) {
    .drawer {
      padding-top: var(--space-4);
      padding-bottom: var(--space-5);
      gap: var(--space-3);
    }

    .drawer__brand-img {
      width: 108px;
      height: 61px;
    }

    .drawer__links {
      gap: 2px;
    }

    .drawer__link {
      min-height: 42px;
    }

    .drawer__link--pill {
      min-height: 46px;
      margin: var(--space-1) 0;
    }

    .drawer__footer {
      gap: var(--space-2);
      padding-top: var(--space-3);
    }

    .drawer__whatsapp {
      min-height: 42px;
    }

    .drawer__social-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  const veil = document.getElementById('drawer-veil') as HTMLDivElement | null;
  const panel = document.getElementById('drawer-panel') as HTMLElement | null;
  const openBtn = document.getElementById('drawer-open-btn') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('drawer-close-btn') as HTMLButtonElement | null;

  if (veil && panel && openBtn && closeBtn) {
    let pushedHistoryEntry = false;

    const focusableSelector =
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function getFocusable(): HTMLElement[] {
      return Array.from(panel!.querySelectorAll<HTMLElement>(focusableSelector));
    }

    function isOpen(): boolean {
      return panel!.dataset.open === 'true';
    }

    function openDrawer(): void {
      panel!.dataset.open = 'true';
      veil!.dataset.open = 'true';
      veil!.hidden = false;
      panel!.setAttribute('aria-hidden', 'false');
      panel!.removeAttribute('inert');
      openBtn!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
      window.history.pushState({ drawerOpen: true }, '');
      pushedHistoryEntry = true;
    }

    // fromPopState=true means the history entry is already gone (the back
    // button/gesture popped it) — don't call history.back() again.
    function closeDrawer(fromPopState = false): void {
      if (!isOpen()) return;
      panel!.dataset.open = 'false';
      veil!.dataset.open = 'false';
      panel!.setAttribute('aria-hidden', 'true');
      panel!.setAttribute('inert', '');
      openBtn!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      veil!.hidden = true;
      openBtn!.focus();
      if (pushedHistoryEntry) {
        pushedHistoryEntry = false;
        if (!fromPopState) window.history.back();
      }
    }

    openBtn.addEventListener('click', () => {
      if (isOpen()) closeDrawer();
      else openDrawer();
    });
    closeBtn.addEventListener('click', () => closeDrawer());
    veil.addEventListener('click', () => closeDrawer());

    // Scrolls straight to the section instead of only reassigning
    // location.hash (which stopped re-triggering the browser's own anchor
    // scroll once this ran through the drawer's history.back() round-trip —
    // the reported "nav links don't work" bug).
    function scrollToHash(hash: string): void {
      const target = document.getElementById(hash.slice(1));
      if (target) target.scrollIntoView({ block: 'start' });
      else window.location.hash = hash;
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-drawer-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        // Cross-page links (/cotizador, /contacto, or /#id clicked from a
        // sub-page) are real navigations — let the browser handle them.
        const isSamePageHash = link.pathname === window.location.pathname && link.hash.length > 0;
        if (!isSamePageHash) return;

        event.preventDefault();
        const target = link.hash;
        if (pushedHistoryEntry) {
          // Consume the drawer's pushed entry in place (replaceState)
          // instead of calling history.back(): a real back-navigation lets
          // the browser restore that entry's original (pre-scroll) scroll
          // position right after our own scrollIntoView runs, snapping the
          // page straight back to the top.
          window.history.replaceState(null, '', target);
          pushedHistoryEntry = false;
          closeDrawer();
        } else {
          window.history.pushState(null, '', target);
          closeDrawer();
        }
        scrollToHash(target);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        closeDrawer();
        return;
      }
      if (event.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener('popstate', () => {
      if (isOpen()) closeDrawer(true);
    });

    function scrollToTop(): void {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, left: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    // Same-pathname links with no hash (drawer/footer "Contacto", the
    // top-bar logo on the home page, etc.) are real <a href> elements
    // pointing at the page the visitor is already on. Left alone, the
    // browser treats a click on one as a normal navigation and does a full
    // reload. Intercept those here (document-level delegation covers the
    // drawer, the footer and the top bar in one place) and just close the
    // drawer + scroll to top instead. In-page hash links keep the dedicated
    // scrollToHash branch above untouched.
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      const link = target?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      if (link.target && link.target !== '_self') return;
      if (link.origin !== window.location.origin) return;
      if (link.pathname !== window.location.pathname) return;
      if (link.hash) return;

      event.preventDefault();
      if (pushedHistoryEntry) {
        // Consume the drawer's pushed history entry in place, same as the
        // hash branch above — no history.back() round-trip.
        window.history.replaceState(null, '', link.pathname + link.search);
        pushedHistoryEntry = false;
        closeDrawer();
      } else if (isOpen()) {
        closeDrawer();
      }
      scrollToTop();
    });
  }
</script>
