---
// Contacto — #contacto section (spec §1 item 8, §2.9). Static info block
// (T9.1) + the interactive ContactForm island (T9.2), hydrated
// client:visible since it is far down the page.
import { buildWaLink } from '@integrations/whatsapp/waLink';
import ContactForm from '@islands/ContactForm';

const waHref = buildWaLink();
---

<section id="contacto" class="contacto">
  <div class="contacto__intro">
    <p class="contacto__kicker">CONTACTO</p>
    <h2 class="contacto__title">Hablemos de tu proyecto</h2>
    <p class="contacto__lead">Escríbenos por WhatsApp o visita nuestro taller en Ciudad Merliot.</p>
  </div>

  <div class="contacto__grid">
    <div class="contacto__info">
      <ul aria-label="Datos de contacto" class="contacto__list">
        <li class="contacto__item">
          <span class="contacto__icon contacto__icon--whatsapp" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"
              ><path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z"></path><path
                d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z"
              ></path></svg
            >
          </span>
          <div class="contacto__item-body">
            <span class="contacto__item-label">WhatsApp</span>
            <a href={waHref} class="contacto__item-value">7680-2410</a>
          </div>
        </li>
        <li class="contacto__item">
          <span class="contacto__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"
              ><path d="M5 4.5h3l1.5 4-2 1.3a10.5 10.5 0 0 0 6.7 6.7l1.3-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 6.1 1.5 1.5 0 0 1 5 4.5z"
              ></path></svg
            >
          </span>
          <div class="contacto__item-body">
            <span class="contacto__item-label">Teléfonos</span>
            <span class="contacto__item-phones">
              <a href="tel:+50322782460">2278-2460</a>
              <a href="tel:+50322084101">2208-4101</a>
              <a href="tel:+50325637742">2563-7742</a>
            </span>
          </div>
        </li>
        <li class="contacto__item">
          <span class="contacto__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"
              ><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"></path><circle
                cx="12"
                cy="10"
                r="2.3"></circle></svg
            >
          </span>
          <div class="contacto__item-body">
            <span class="contacto__item-label">Taller</span>
            <span class="contacto__item-value"
              >Calle El Pedregal, local 29 G, Ciudad Merliot <span class="contacto__badge"
                >[municipio — confirmar]</span
              ></span
            >
            <a
              href="https://www.google.com/maps/search/?api=1&query=ALCUSA+Calle+El+Pedregal+Ciudad+Merliot"
              class="contacto__map-link"
            >
              Ver ubicación en el mapa
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16L16 8M9 8h7v7"></path></svg>
            </a>
          </div>
        </li>
        <li class="contacto__item">
          <span class="contacto__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"
              ></path></svg
            >
          </span>
          <div class="contacto__item-body">
            <span class="contacto__item-label">Horario</span>
            <span class="contacto__badge">[HORARIO — confirmar]</span>
          </div>
        </li>
        <li class="contacto__item contacto__item--last">
          <span class="contacto__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24"
              ><rect x="3.5" y="5" width="17" height="14" rx="2.5"></rect><path d="M4 6.5l8 6 8-6"></path></svg
            >
          </span>
          <div class="contacto__item-body">
            <span class="contacto__item-label">Correo</span>
            <span class="contacto__badge">[correo — confirmar]</span>
          </div>
        </li>
      </ul>

      <div class="contacto__social">
        <span class="contacto__social-label">Síguenos</span>
        <div class="contacto__social-icons">
          <a href="https://instagram.com/alcusasv" aria-label="Instagram @alcusasv" rel="noopener" class="contacto__social-icon"
            ><svg width="20" height="20" viewBox="0 0 24 24"
              ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"
              ></circle><circle cx="17.2" cy="6.8" r=".6"></circle></svg
            ></a
          >
          <a href="https://tiktok.com/@alcusaes" aria-label="TikTok @alcusaes" rel="noopener" class="contacto__social-icon"
            ><svg width="20" height="20" viewBox="0 0 24 24"
              ><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M14 4c.4 2.6 2.2 4.3 5 4.5"></path></svg
            ></a
          >
          <a
            href="https://youtube.com/@alcusaelsalvador8209"
            aria-label="YouTube @alcusaelsalvador8209"
            rel="noopener"
            class="contacto__social-icon"
            ><svg width="20" height="20" viewBox="0 0 24 24"
              ><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10.5 9.5v5l4.3-2.5z"></path></svg
            ></a
          >
        </div>
      </div>
    </div>

    <ContactForm client:visible />
  </div>
</section>

<style>
  .contacto {
    padding: var(--space-8) var(--space-6) var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contacto__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contacto__kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-focus);
  }

  .contacto__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: 600;
    font-size: 1.875rem;
    line-height: 1.15;
  }

  .contacto__lead {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .contacto__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contacto__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contacto__list {
    margin: 0;
    padding: 0 var(--space-5);
    list-style: none;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(16, 33, 61, 0.06);
    display: flex;
    flex-direction: column;
  }

  .contacto__item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid #dfe6ef;
  }

  .contacto__item--last {
    border-bottom: 0;
  }

  .contacto__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-surface-tint);
    color: var(--color-focus);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contacto__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contacto__icon--whatsapp {
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
  }

  .contacto__item-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.4;
  }

  .contacto__item-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .contacto__item-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  a.contacto__item-value {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .contacto__item-phones {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--space-3);
    font-size: var(--font-size-body-mobile);
    font-weight: 600;
  }

  .contacto__item-phones a,
  .contacto__item-value a {
    color: var(--color-ink);
  }

  .contacto__badge {
    display: inline-block;
    font-size: var(--font-size-body-sm-mobile);
    background: #fff4e0;
    color: #8a5a00;
    border-radius: var(--radius-xs);
    padding: 0 var(--space-2);
    width: fit-content;
  }

  .contacto__map-link {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    font-size: var(--font-size-body-sm-mobile);
    font-weight: 700;
  }

  .contacto__social {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contacto__social-label {
    font-size: var(--font-size-body-sm-mobile);
    font-weight: 700;
  }

  .contacto__social-icons {
    display: flex;
    gap: var(--space-2);
  }

  .contacto__social-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid #dfe6ef;
    color: var(--color-focus);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contacto__social-icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 768px) {
    .contacto {
      padding: var(--space-10) var(--space-8) var(--space-12);
    }
  }

  @media (min-width: 1024px) {
    .contacto {
      max-width: var(--container-page);
      margin: 0 auto;
      width: 100%;
      padding: var(--space-16) var(--space-8);
    }

    .contacto__grid {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-8);
    }

    .contacto__info {
      flex: 0 0 58%;
    }
  }
</style>
