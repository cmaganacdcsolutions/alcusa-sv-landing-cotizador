---
// Galeria — real-project photo strip (spec §1 item 4 / S4 T4.2). Exactly the
// 6 real WhatsApp customer photos (product-whatsapp-01..06.jpeg) — no
// AI-generated or third-party-rights image (see prototype-spec.md §1 item 4
// rationale + open question #11).
// Mobile/tablet (<1024px): horizontal snap-scroll strip (Main.dc.html /
// android-01). Desktop (>=1024px): desktop-01-inicio's masonry — the board
// curates 10 photos across 5 columns, but our AC caps this gallery at
// exactly these 6 real photos, so it's a 3-column CSS multi-column masonry
// with per-card heights lifted from the board's own height set (240-440px)
// instead of the board's fixed 5-col/10-photo composition.
// Header row (kicker+title left, caption+Instagram link right on desktop,
// stacked on mobile); the "Ver más en Instagram" caption+link (per
// desktop-01-inicio.dc.html lines 123-124) replaces the old "Desliza para
// ver más" copy at every breakpoint (Foreman correction 2026-09-28 —
// Main.dc.html's plain caption is superseded by this decision).
const PHOTOS = [
  { src: '/images/galeria-01.jpeg', alt: 'Puerta de baño con vidrio decorado instalada', width: 934, height: 1280 },
  { src: '/images/galeria-02.jpeg', alt: 'División de vidrio esmerilado instalada', width: 1600, height: 1200 },
  { src: '/images/galeria-03.jpeg', alt: 'Ducha de vidrio corrediza con marco plateado', width: 960, height: 1280 },
  { src: '/images/galeria-04.jpeg', alt: 'Ventanas correderas de aluminio con perfil negro instaladas', width: 1200, height: 1600 },
  { src: '/images/galeria-05.jpeg', alt: 'Puerta de vidrio corrediza de aluminio negro en fachada', width: 1600, height: 1200 },
  { src: '/images/galeria-06.jpeg', alt: 'Ducha de vidrio con marco negro y acabado en mármol', width: 1200, height: 1600 },
] as const;
---

<section id="galeria" class="galeria" aria-labelledby="galeria-title">
  <div class="galeria__header">
    <div class="galeria__intro">
      <p class="galeria__kicker">Proyectos reales</p>
      <h2 id="galeria-title" class="galeria__title">Instalaciones de nuestros clientes</h2>
    </div>
    <div class="galeria__caption">
      <p class="galeria__subtitle">Fotos enviadas por clientes.</p>
      <a
        href="https://instagram.com/alcusasv"
        target="_blank"
        rel="noopener"
        class="galeria__ig-link"
        aria-label="Ver más fotos en Instagram, arroba alcusasv"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
          ><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"
          ></circle><circle cx="17.2" cy="6.8" r=".6"></circle></svg
        >
        Ver más en Instagram &middot; @alcusasv
      </a>
    </div>
  </div>

  <div class="galeria__strip-wrap">
    <button type="button" class="galeria__strip-nav galeria__strip-nav--prev" data-strip-prev aria-label="Foto anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <ul class="galeria__strip" id="galeria-strip">
      {
        PHOTOS.map((photo, index) => (
          <li class="galeria__item">
            <button
              type="button"
              class="galeria__trigger"
              data-lightbox-trigger
              data-index={index}
              data-src={photo.src}
              data-alt={photo.alt}
              aria-label={`Ampliar foto ${index + 1} de ${PHOTOS.length}: ${photo.alt}`}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="galeria__img"
              />
            </button>
          </li>
        ))
      }
    </ul>
    <button type="button" class="galeria__strip-nav galeria__strip-nav--next" data-strip-next aria-label="Foto siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>

  <div id="galeria-veil" class="galeria__veil" hidden></div>
  <div
    id="galeria-lightbox"
    class="galeria__lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada"
    aria-hidden="true"
    inert
  >
    <button type="button" id="galeria-lightbox-close" class="galeria__lightbox-close" aria-label="Cerrar foto ampliada">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <button type="button" id="galeria-lightbox-prev" class="galeria__lightbox-nav galeria__lightbox-nav--prev" aria-label="Foto anterior">
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <button type="button" id="galeria-lightbox-next" class="galeria__lightbox-nav galeria__lightbox-nav--next" aria-label="Foto siguiente">
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
    <img id="galeria-lightbox-img" src="" alt="" class="galeria__lightbox-img" />
    <p id="galeria-lightbox-counter" class="galeria__lightbox-counter" aria-live="polite"></p>
  </div>
</section>

<style>
  .galeria {
    padding: var(--space-8) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .galeria__header {
    padding: 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .galeria__intro,
  .galeria__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .galeria__kicker {
    margin: 0;
    font-size: var(--font-size-caption-mobile);
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .galeria__title {
    margin: 0;
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--font-weight-display-medium);
    font-family: var(--font-family-display);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .galeria__subtitle {
    margin: 0;
    font-size: var(--font-size-body-sm-mobile);
    color: var(--color-ink-muted);
  }

  .galeria__ig-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    font-size: var(--font-size-body-sm-mobile);
    font-weight: var(--font-weight-body-bold);
    color: var(--color-accent);
    text-decoration: none;
  }

  .galeria__ig-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .galeria__strip-wrap {
    position: relative;
  }

  .galeria__strip-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 44px;
    height: 44px;
    transform: translateY(-50%);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .galeria__strip-nav:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .galeria__strip-nav--prev {
    left: var(--space-2);
  }

  .galeria__strip-nav--next {
    right: var(--space-2);
  }

  .galeria__strip {
    margin: 0;
    padding: 0 var(--space-6) var(--space-2);
    list-style: none;
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--space-6);
  }

  .galeria__item {
    flex: 0 0 240px;
    scroll-snap-align: start;
  }

  .galeria__trigger {
    display: block;
    width: 100%;
    height: 300px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .galeria__trigger:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .galeria__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .galeria__veil {
    position: fixed;
    inset: 0;
    background: var(--color-scrim-ink);
    z-index: 40;
  }

  .galeria__veil[hidden] {
    display: none;
  }

  .galeria__lightbox {
    position: fixed;
    inset: 0;
    z-index: 41;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .galeria__lightbox[data-open='true'] {
    display: flex;
  }

  .galeria__lightbox-img {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-md);
    display: block;
  }

  .galeria__lightbox-close {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .galeria__lightbox-close:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .galeria__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .galeria__lightbox-nav:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .galeria__lightbox-nav--prev {
    left: var(--space-4);
  }

  .galeria__lightbox-nav--next {
    right: var(--space-4);
  }

  .galeria__lightbox-counter {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-ink);
    font-size: var(--font-size-caption-mobile);
    font-weight: var(--font-weight-body-medium);
  }

  @media (min-width: 1024px) {
    .galeria__strip-nav {
      display: none;
    }

    .galeria {
      padding: var(--space-24) 0;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-soft);
      border-bottom: 1px solid var(--color-border-soft);
    }

    .galeria__header,
    .galeria__strip {
      max-width: var(--container-page);
      margin: 0 auto;
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }

    .galeria__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-10);
    }

    .galeria__caption {
      align-items: flex-end;
      text-align: right;
    }

    .galeria__title {
      font-size: var(--font-size-h2-desktop);
    }

    .galeria__subtitle {
      font-size: var(--font-size-body-lg-desktop);
    }

    .galeria__ig-link {
      font-size: var(--font-size-body-sm-desktop);
    }

    .galeria__strip {
      display: block;
      column-count: 3;
      column-gap: var(--space-6);
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding: 0;
    }

    .galeria__item {
      display: block;
      flex: none;
      break-inside: avoid;
      margin-bottom: var(--space-6);
      scroll-snap-align: none;
    }

    /* Per-card heights lifted from desktop-01-inicio.dc.html's masonry
       (height set: 240-440px) so cards read at the board's scale instead of
       shrinking to each photo's raw intrinsic aspect ratio. */
    .galeria__item:nth-child(1) .galeria__trigger {
      height: 420px;
    }

    .galeria__item:nth-child(2) .galeria__trigger {
      height: 280px;
    }

    .galeria__item:nth-child(3) .galeria__trigger {
      height: 360px;
    }

    .galeria__item:nth-child(4) .galeria__trigger {
      height: 440px;
    }

    .galeria__item:nth-child(5) .galeria__trigger {
      height: 320px;
    }

    .galeria__item:nth-child(6) .galeria__trigger {
      height: 400px;
    }

    .galeria__img {
      height: 100%;
    }
  }
</style>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
  const veil = document.getElementById('galeria-veil');
  const box = document.getElementById('galeria-lightbox');
  const closeBtn = document.getElementById('galeria-lightbox-close') as HTMLButtonElement | null;
  const prevBtn = document.getElementById('galeria-lightbox-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('galeria-lightbox-next') as HTMLButtonElement | null;
  const img = document.getElementById('galeria-lightbox-img') as HTMLImageElement | null;
  const counter = document.getElementById('galeria-lightbox-counter');
  const strip = document.getElementById('galeria-strip') as HTMLUListElement | null;
  const stripPrevBtn = document.querySelector<HTMLButtonElement>('[data-strip-prev]');
  const stripNextBtn = document.querySelector<HTMLButtonElement>('[data-strip-next]');

  if (veil && box && closeBtn && prevBtn && nextBtn && img && counter && triggers.length > 0) {
    let lastTrigger: HTMLButtonElement | null = null;
    let currentIndex = 0;
    const total = triggers.length;
    const focusOrder = [prevBtn, nextBtn, closeBtn];

    function isOpen(): boolean {
      return box!.dataset.open === 'true';
    }

    function render(index: number): void {
      const trigger = triggers[index];
      img!.src = trigger.dataset.src ?? '';
      img!.alt = trigger.dataset.alt ?? '';
      counter!.textContent = `${index + 1} / ${total}`;
    }

    function goTo(index: number): void {
      currentIndex = (index + total) % total;
      render(currentIndex);
    }

    function openLightbox(trigger: HTMLButtonElement): void {
      lastTrigger = trigger;
      currentIndex = Number(trigger.dataset.index ?? '0');
      render(currentIndex);
      box!.dataset.open = 'true';
      veil!.dataset.open = 'true';
      veil!.hidden = false;
      box!.setAttribute('aria-hidden', 'false');
      box!.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
    }

    function closeLightbox(): void {
      if (!isOpen()) return;
      box!.dataset.open = 'false';
      veil!.dataset.open = 'false';
      box!.setAttribute('aria-hidden', 'true');
      box!.setAttribute('inert', '');
      veil!.hidden = true;
      document.body.style.overflow = '';
      img!.src = '';
      lastTrigger?.focus();
      lastTrigger = null;
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openLightbox(trigger));
    });

    closeBtn.addEventListener('click', () => closeLightbox());
    veil.addEventListener('click', () => closeLightbox());
    prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
    nextBtn.addEventListener('click', () => goTo(currentIndex + 1));

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        closeLightbox();
        return;
      }
      if (event.key === 'ArrowLeft') {
        goTo(currentIndex - 1);
        return;
      }
      if (event.key === 'ArrowRight') {
        goTo(currentIndex + 1);
        return;
      }
      // Focus trap across the three focusable controls (prev/next/close).
      if (event.key === 'Tab') {
        event.preventDefault();
        const at = focusOrder.indexOf(document.activeElement as HTMLButtonElement);
        const nextAt = event.shiftKey
          ? (at - 1 + focusOrder.length) % focusOrder.length
          : (at + 1) % focusOrder.length;
        focusOrder[nextAt < 0 ? 0 : nextAt].focus();
      }
    });

    // Swipe left/right on touch devices to move between photos.
    let touchStartX: number | null = null;
    box.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    box.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const endX = event.changedTouches[0]?.clientX ?? touchStartX;
        const deltaX = endX - touchStartX;
        const SWIPE_THRESHOLD = 40;
        if (deltaX > SWIPE_THRESHOLD) goTo(currentIndex - 1);
        else if (deltaX < -SWIPE_THRESHOLD) goTo(currentIndex + 1);
        touchStartX = null;
      },
      { passive: true },
    );
  }

  // Mobile snap-scroll strip prev/next controls.
  if (strip && stripPrevBtn && stripNextBtn) {
    function stripStep(): number {
      const item = strip!.querySelector<HTMLElement>('.galeria__item');
      if (!item) return strip!.clientWidth;
      const styles = window.getComputedStyle(strip!);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return item.getBoundingClientRect().width + gap;
    }

    function scrollStrip(direction: 1 | -1): void {
      const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth';
      strip!.scrollBy({ left: direction * stripStep(), behavior });
    }

    stripPrevBtn.addEventListener('click', () => scrollStrip(-1));
    stripNextBtn.addEventListener('click', () => scrollStrip(1));
  }
</script>
