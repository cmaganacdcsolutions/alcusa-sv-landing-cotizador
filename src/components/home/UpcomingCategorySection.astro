---
// Seccion placeholder de categorias sin fotos/precios (Espejos, Zarandas, Fachadas comerciales). Reusa .csec/.csec__grid
// de CatalogSection y la superficie de .pcard; sin enlaces al cotizador: el CTA abre WhatsApp con un asesor.
import {
  UPCOMING_PLACEHOLDER_COPY as COPY,
  UPCOMING_PLACEHOLDER_COUNT,
  type UpcomingCategory,
} from '@content/upcomingCategories';
import { buildWaLink } from '@integrations/whatsapp/waLink';

interface Props {
  category: UpcomingCategory;
}
const { category } = Astro.props;
const headingId = `${category.slug}-t`;
const cards = Array.from({ length: UPCOMING_PLACEHOLDER_COUNT }, (_, i) => i);
---

<section id={category.slug} class="csec" aria-labelledby={headingId}>
  <header class="csec__head" data-reveal>
    <h2 id={headingId} class="csec__title" tabindex="-1">{category.name}</h2>
  </header>
  <div class="csec__grid">
    {
      cards.map(() => (
        <article class="pcard pcard--pending" data-pending-card>
          <div class="pcard__media">
            <div class="pcard__nophoto pcard__nophoto--pending">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <circle cx="9" cy="10" r="1.75" />
                <path d="m21 16-5-5-9 9" />
              </svg>
              <span>{COPY.image}</span>
            </div>
          </div>
          <div class="pcard__body">
            <h3 class="pcard__title">{COPY.title}</h3>
            <p class="pcard__price pcard__price--pending">{COPY.price}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="csec__cta">
    <a class="pcard__go" href={buildWaLink(category.waMessage)} target="_blank" rel="noopener noreferrer" data-upcoming-cta>
      {COPY.cta}
    </a>
  </p>
</section>

<style is:global>
  .pcard--pending {
    border-style: dashed;
    border-color: var(--color-warning);
  }
  .pcard__nophoto--pending {
    align-content: center;
    justify-items: center;
    gap: var(--space-1);
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border: 1px dashed var(--color-warning);
  }
  .pcard__price--pending {
    color: var(--color-warning);
  }
  .csec__cta {
    margin: var(--space-4) 0 0;
  }
</style>
