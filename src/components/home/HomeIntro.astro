---
// Intro compacta del inicio (reemplaza Hero): kicker + h1 + 1 linea + enlace a promos.
import { getActivePromotions } from '@content/promotions';
const hasPromos = getActivePromotions().length > 0;
---

<section id="inicio" class="hintro" aria-labelledby="hintro-title" data-reveal>
  <p class="hintro__kicker">ALCUSA · FABRICADO A TU MEDIDA</p>
  <h1 id="hintro-title" class="hintro__title">¿Qué quieres cambiar en tu casa hoy?</h1>
  <p class="hintro__lede">Elige tu producto, marca las opciones y pasa al cotizador con todo listo.</p>
  {hasPromos && <a class="hintro__link" href="#promociones">Ver promociones del mes</a>}
</section>

<style is:global>
  .hintro {
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) 0;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
  }
  .hintro__kicker {
    margin: 0;
    font: var(--font-weight-body-bold) 12px/16px var(--font-family-body);
    letter-spacing: 0.08em;
    color: var(--color-accent-on-dark);
  }
  .hintro__title {
    margin: 0;
    font-size: 28px;
    line-height: 34px;
    font-weight: var(--font-weight-display-bold);
    color: var(--color-text-on-dark);
  }
  .hintro__lede {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-on-dark-muted);
  }
  .hintro__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-full);
    font: var(--font-weight-body-bold) 15px/20px var(--font-family-body);
    color: var(--color-accent-on-dark);
  }
  /* Hover como .nav__link: pildora noche elevada + texto blanco, sin movimiento. */
  @media (hover: hover) and (pointer: fine) {
    .hintro__link {
      transition:
        background-color var(--hover-dur) var(--hover-ease),
        color var(--hover-dur) var(--hover-ease);
    }
    .hintro__link:hover {
      background: var(--color-surface-dark-raised);
      color: var(--color-text-on-dark);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hintro__link {
      transition: none;
    }
  }
  @media (min-width: 1024px) {
    .hintro {
      padding: var(--space-10) var(--space-8) var(--space-6);
    }
    .hintro__title {
      font-size: 40px;
      line-height: 48px;
    }
  }
</style>
