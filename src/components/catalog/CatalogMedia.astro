---
// One photo slot: PhotoFrame (regla "Foto completa") or, when the data has no
// image, the "FOTO PRÓXIMAMENTE" placeholder. Never renders a broken <img>.
import PhotoFrame, { type PhotoRatio } from '@components/PhotoFrame';
import type { CatalogImage } from '@content/catalogContent';

interface Props {
  image: CatalogImage | null;
  ratio: PhotoRatio;
  /** Placeholder geometry: card (150 tall / 1:1 desktop) or detail. */
  kind: 'card' | 'detail';
  eager?: boolean;
  iconSize?: number;
}
const { image, ratio, kind, eager = false } = Astro.props;
---

{
  image ? (
    <PhotoFrame src={image.src} alt={image.alt} ratio={ratio} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class={`cat-ph cat-ph--${kind}`} data-testid="foto-proximamente">
      <svg width={kind === 'detail' ? 40 : 32} height={kind === 'detail' ? 40 : 32} viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="14" rx="3" />
        <circle cx="9" cy="10.5" r="1.6" />
        <path d="M4 17l5-4.5 4 3.5 3-2.5 4 3.5" />
      </svg>
      FOTO PRÓXIMAMENTE
    </div>
  )
}
