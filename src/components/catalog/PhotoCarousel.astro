---
// Shared "project photos" carousel (catalog index + category + product pages).
// CSS scroll-snap track (works swipe-only without JS) + prev/next buttons and a
// "n / N" indicator wired by the inline script. Slides are buttons that open a native
// <dialog> lightbox (photo complete, contain). Autoplay follows the
// WAI-ARIA APG carousel pattern: pause button, pause on hover / keyboard focus / hidden
// tab / after manual interaction, and none under prefers-reduced-motion.
import PhotoFrame from '@components/PhotoFrame';
import type { CatalogImage } from '@content/catalogContent';

interface Props {
  images: readonly CatalogImage[];
  label: string;
}
const { images, label } = Astro.props;
const total = images.length;
---

{
  total > 0 && (
    <div
      class="pcar"
      data-carousel
      data-single={total < 2 ? '' : undefined}
      role="region"
      aria-roledescription="carrusel"
      aria-label={label}
    >
      <div class="pcar__stage">
        <ul class="pcar__track" data-track tabindex="0" aria-live="off" aria-label={`${label}, use las flechas del teclado`}>
          {images.map((img, i) => (
            <li class="pcar__slide">
              <div class="pcar__group" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${total}`}>
                <button
                  type="button"
                  class="pcar__open"
                  data-open={i}
                  data-alt={img.alt}
                  aria-haspopup="dialog"
                  aria-label={`Ver foto ${i + 1} de ${total}: ${img.alt}`}
                >
                  <PhotoFrame
                    className="pcar__frame"
                    fit={img.kind === 'render' ? 'cover' : 'contain'}
                    src={img.src}
                    alt={img.alt}
                    width={img.width}
                    height={img.height}
                    ratio="4/3"
                    style={{ width: '100%' }}
                    loading="lazy"
                  />
                </button>
              </div>
            </li>
          ))}
        </ul>
        <button type="button" class="pcar__btn pcar__btn--prev" data-prev aria-label="Foto anterior" disabled>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="pcar__btn pcar__btn--next" data-next aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div class="pcar__bar">
        <button type="button" class="pcar__toggle" data-toggle aria-pressed="false" aria-label="Pausar carrusel" hidden>
          <svg class="pcar__ico-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          </svg>
          <svg class="pcar__ico-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M8 5l11 7-11 7z" fill="currentColor" />
          </svg>
        </button>
        <p class="pcar__count" data-count aria-hidden="true">
          {`1 / ${total}`}
        </p>
      </div>
      <dialog class="pcar__dialog" data-dialog aria-label={`${label}, foto ampliada`}>
        <div class="pcar__dlg-inner">
          <button type="button" class="pcar__dlg-btn pcar__dlg-close" data-close>
            Cerrar
          </button>
          <div class="pcar__dlg-stage" data-swipe>
            <button type="button" class="pcar__dlg-btn pcar__dlg-nav pcar__dlg-prev" data-lprev aria-label="Foto anterior">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <span data-lslot />
            <button type="button" class="pcar__dlg-btn pcar__dlg-nav pcar__dlg-next" data-lnext aria-label="Foto siguiente">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <p class="pcar__dlg-cap">
            <span data-lcount>{`1 / ${total}`}</span> &middot; <span data-lcap />
          </p>
        </div>
      </dialog>
    </div>
  )
}

<style is:global>
  .pcar {
    /* Mismo contenedor y mismo marco 4:3 en todas las paginas. */
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    --pcar-per-view: 1.1;
    --pcar-gap: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .pcar__stage {
    position: relative;
    min-width: 0;
  }
  .pcar__track {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-1);
    display: flex;
    align-items: center;
    gap: var(--pcar-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    position: relative;
    border-radius: var(--radius-lg);
  }
  .pcar__track::-webkit-scrollbar {
    display: none;
  }
  .pcar__track:focus-visible,
  .pcar__btn:focus-visible,
  .pcar__open:focus-visible,
  .pcar__toggle:focus-visible,
  .pcar__dlg-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .pcar__slide {
    flex: 0 0 calc((100% - (var(--pcar-per-view) - 1) * var(--pcar-gap)) / var(--pcar-per-view));
    min-width: 0;
    margin: 0;
    scroll-snap-align: start;
  }
  .pcar__open {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--radius-lg);
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }
  /* Marco uniforme: la foto va completa (contain) y centrada; las de baja resolucion se escalan. */
  .pcar__frame {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .pcar__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-md);
    cursor: pointer;
  }
  .pcar__btn--prev {
    left: var(--space-2);
  }
  .pcar__btn--next {
    right: var(--space-2);
  }
  .pcar__btn:disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: default;
  }
  .pcar__bar {
    display: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }
  .pcar__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
    cursor: pointer;
  }
  .pcar__toggle[hidden] {
    display: none;
  }
  .pcar__toggle[aria-pressed='false'] .pcar__ico-play,
  .pcar__toggle[aria-pressed='true'] .pcar__ico-pause {
    display: none;
  }
  .pcar__count {
    margin: 0;
    text-align: center;
    font-size: 14px; /* TODO(token) */
    color: var(--color-ink-muted); /* #445068 sobre crema: >= 7:1 */
    font-variant-numeric: tabular-nums;
  }
  /* Controls only once JS is ready and there is something to scroll. */
  .pcar[data-ready]:not([data-fit]):not([data-single]) .pcar__btn {
    display: grid;
  }
  .pcar[data-ready]:not([data-fit]):not([data-single]) .pcar__bar {
    display: flex;
  }
  @media (min-width: 768px) {
    .pcar {
      --pcar-per-view: 2;
      --pcar-gap: var(--space-4);
    }
  }
  /* Lightbox: foto completa (contain), escalada al marco. */
  .pcar__dialog {
    width: min(96vw, 1100px);
    max-width: 96vw;
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
    color: #fff;
    overflow: hidden;
  }
  .pcar__dialog::backdrop {
    background: rgba(8, 14, 28, 0.82);
  }
  .pcar__dlg-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .pcar__dlg-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: pan-y;
  }
  .pcar__dlg-img {
    display: block;
    width: 100%;
    height: 72vh;
    object-fit: contain;
    object-position: 50% 50%;
    border-radius: var(--radius-md);
    user-select: none;
  }
  .pcar__dlg-btn {
    border: 0;
    cursor: pointer;
    background: var(--color-surface);
    color: var(--color-primary);
    font: inherit;
    font-weight: 700;
    box-shadow: var(--shadow-md);
  }
  .pcar__dlg-close {
    align-self: flex-end;
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-full);
  }
  .pcar__dlg-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
  }
  .pcar__dlg-prev {
    left: var(--space-1);
  }
  .pcar__dlg-next {
    right: var(--space-1);
  }
  .pcar[data-single] .pcar__dlg-nav {
    display: none;
  }
  .pcar__dlg-cap {
    margin: 0;
    text-align: center;
    font-size: 14px;
    line-height: 1.4;
    color: #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pcar__track {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 5000;
  const HOLD_MS = 10000; // pausa tras interaccion manual

  function init(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    if (!track || !prev || !next || !count) return;
    const slides = Array.from(track.children) as HTMLElement[];
    const total = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;

    const maxScroll = (): number => track.scrollWidth - track.clientWidth;
    const slideLeft = (s: HTMLElement): number => s.offsetLeft - track.offsetLeft;

    // Index-based navigation: nearest slide start to scrollLeft (snap-safe, no rounding of widths).
    const navIndex = (): number => {
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(slideLeft(s) - track.scrollLeft);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    const atEnd = (): boolean => maxScroll() > 1 && track.scrollLeft >= maxScroll() - 2;

    const update = (): void => {
      raf = 0;
      root.toggleAttribute('data-fit', maxScroll() <= 1);
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll() - 1;
      count.textContent = `${(atEnd() ? total - 1 : navIndex()) + 1} / ${total}`;
    };
    const schedule = (): void => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    const scrollToSlide = (idx: number): void => {
      const target = slides[Math.min(total - 1, Math.max(0, idx))];
      track.scrollTo({ left: slideLeft(target), behavior: reduce.matches ? 'auto' : 'smooth' });
    };
    // Target index survives mid-animation clicks; cleared when the scroll has
    // really stopped (scrollend, or scrollLeft unchanged for several frames).
    // No fixed timeout: smooth-scroll duration varies with load/workers.
    let pending: number | null = null;
    let watch = 0;
    const settled = (): void => {
      cancelAnimationFrame(watch);
      watch = 0;
      pending = null;
      update();
    };
    const watchSettle = (): void => {
      cancelAnimationFrame(watch);
      let last = track.scrollLeft;
      let still = 0;
      const step = (): void => {
        const now = track.scrollLeft;
        still = Math.abs(now - last) < 0.5 ? still + 1 : 0;
        last = now;
        if (still >= 6) settled();
        else watch = requestAnimationFrame(step);
      };
      watch = requestAnimationFrame(step);
    };
    const go = (dir: 1 | -1): void => {
      pending = Math.min(total - 1, Math.max(0, (pending ?? navIndex()) + dir));
      scrollToSlide(pending);
      watchSettle();
    };

    // --- Autoplay (WAI-ARIA APG carousel) ---------------------------------
    let userPaused = false;
    let holdUntil = 0;
    let hovered = false;
    let inLightbox = false;
    let timer = 0;
    const canAutoplay = (): boolean => !reduce.matches && total > 1 && maxScroll() > 1;
    const playing = (): boolean =>
      canAutoplay() &&
      !userPaused &&
      !hovered &&
      !inLightbox &&
      !document.hidden &&
      !root.matches(':has(:focus-visible)') &&
      Date.now() >= holdUntil;
    const syncUi = (): void => {
      track.setAttribute('aria-live', userPaused || reduce.matches ? 'polite' : 'off');
      if (toggle) toggle.hidden = !canAutoplay();
    };
    const tick = (): void => {
      if (!playing() || watch) return; // never stack on a scroll in flight
      if (atEnd()) {
        pending = 0;
        track.scrollTo({ left: 0, behavior: reduce.matches ? 'auto' : 'smooth' });
        watchSettle();
      } else go(1);
    };
    const startTimer = (): void => {
      window.clearInterval(timer);
      timer = reduce.matches ? 0 : window.setInterval(tick, AUTOPLAY_MS);
    };
    const hold = (): void => {
      holdUntil = Date.now() + HOLD_MS;
    };

    prev.addEventListener('click', () => {
      hold();
      go(-1);
    });
    next.addEventListener('click', () => {
      hold();
      go(1);
    });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        hold();
        go(e.key === 'ArrowRight' ? 1 : -1);
      }
    });
    ['pointerdown', 'wheel', 'touchstart'].forEach((ev) => track.addEventListener(ev, hold, { passive: true }));
    root.addEventListener('mouseenter', () => {
      hovered = true;
    });
    root.addEventListener('mouseleave', () => {
      hovered = false;
    });
    track.addEventListener('scroll', schedule, { passive: true });
    track.addEventListener('scrollend', settled);
    window.addEventListener('resize', () => {
      schedule();
      syncUi();
    });

    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute('aria-label', userPaused ? 'Reanudar carrusel' : 'Pausar carrusel');
      syncUi();
    });

    // --- Lightbox (<dialog>) ----------------------------------------------
    const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]');
    const slot = root.querySelector<HTMLElement>('[data-lslot]');
    const lcap = root.querySelector<HTMLElement>('[data-lcap]');
    const lcount = root.querySelector<HTMLElement>('[data-lcount]');
    if (dialog && slot && lcap && lcount) {
      let limg: HTMLImageElement | null = null; // creada al abrir (no hay <img> sin src en el DOM)
      const openers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-open]'));
      let idx = 0;
      let opener: HTMLElement | null = null;
      const show = (i: number): void => {
        if (!limg) {
          limg = document.createElement('img');
          limg.className = 'pcar__dlg-img';
          limg.setAttribute('data-limg', '');
          slot.replaceWith(limg);
        }
        idx = (i + total) % total;
        const b = openers[idx];
        const photo = b.querySelector<HTMLImageElement>('.photo-frame__img');
        const alt = b.dataset.alt ?? '';
        limg.src = photo?.currentSrc || photo?.src || '';
        limg.alt = alt;
        lcap.textContent = alt;
        lcount.textContent = `${idx + 1} / ${total}`;
      };
      openers.forEach((b, i) =>
        b.addEventListener('click', () => {
          opener = b;
          inLightbox = true;
          show(i);
          dialog.showModal();
        }),
      );
      const close = (): void => dialog.close();
      dialog.addEventListener('close', () => {
        inLightbox = false;
        hold();
        scrollToSlide(idx);
        opener?.focus({ preventScroll: true });
      });
      root.querySelector('[data-close]')?.addEventListener('click', close);
      root.querySelector('[data-lprev]')?.addEventListener('click', () => show(idx - 1));
      root.querySelector('[data-lnext]')?.addEventListener('click', () => show(idx + 1));
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(idx + 1);
        else if (e.key === 'ArrowLeft') show(idx - 1);
      });
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) close(); // backdrop
      });
      const stage = root.querySelector<HTMLElement>('[data-swipe]');
      let x0: number | null = null;
      stage?.addEventListener('pointerdown', (e) => {
        x0 = e.clientX;
      });
      stage?.addEventListener('pointerup', (e) => {
        if (x0 === null) return;
        const dx = e.clientX - x0;
        x0 = null;
        if (Math.abs(dx) > 40) show(dx < 0 ? idx + 1 : idx - 1);
      });
    }

    root.setAttribute('data-ready', '');
    update();
    syncUi();
    startTimer();
    reduce.addEventListener('change', () => {
      syncUi();
      startTimer();
    });
    // Lazy images settle layout late; re-measure once loaded.
    window.addEventListener('load', () => {
      schedule();
      syncUi();
    });
  }
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(init);
</script>
