---
// Footer (navbar spec 01d §1, §3): 3 columnas (marca + WhatsApp + telefonos | Explora | Alcusa)
// + formas de pago + redes + legal. >=1024 en 3 columnas, <1024 apilado.
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();

const EXPLORA = [
  { label: 'Catálogo', href: '/#catalogo' },
  { label: 'Promociones', href: '/#promociones' },
  { label: 'Cotizar', href: '/cotizador' },
  { label: 'Cómo funciona', href: '/#proceso' },
] as const;
const ALCUSA = [
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Visítanos', href: '/contacto#visitanos' },
] as const;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__row">
      <div class="site-footer__col site-footer__brandcol">
        <div class="site-footer__brand">
          <img src="/images/logo-primary.png" alt="" width="36" height="36" />
          <div class="site-footer__brand-text">
            <span class="site-footer__wordmark">Alcusa</span>
            <span class="site-footer__tagline">Disfrutar con calidad</span>
          </div>
        </div>
        <a href={waHref} class="site-footer__whatsapp">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z"></path>
            <path d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z"></path>
          </svg>
          Cotizar por WhatsApp · 7680-2410
        </a>
        <p class="site-footer__phones">
          Teléfono <a href="tel:+50322782460">2278-2460</a>
        </p>
      </div>

      <nav aria-label="Explora" class="site-footer__col site-footer__nav">
        <p class="site-footer__head">Explora</p>
        {EXPLORA.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <nav aria-label="Alcusa" class="site-footer__col site-footer__nav">
        <p class="site-footer__head">Alcusa</p>
        {ALCUSA.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>

    <div class="site-footer__meta">
      <p class="site-footer__pay">
        <span class="site-footer__head">Formas de pago</span>
        Tarjeta de crédito o débito (Wompi) · [contenido Alcusa — pendiente: otras formas de pago]
      </p>
      <div class="site-footer__social">
        <a href="https://instagram.com/alcusasv" aria-label="Instagram @alcusasv" rel="noopener" class="site-footer__social-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r=".6"></circle>
          </svg>
        </a>
        <a href="https://tiktok.com/@alcusaes" aria-label="TikTok @alcusaes" rel="noopener" class="site-footer__social-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"></path>
            <path d="M14 4c.4 2.6 2.2 4.3 5 4.5"></path>
          </svg>
        </a>
        <a
          href="https://youtube.com/@alcusaelsalvador8209"
          aria-label="YouTube @alcusaelsalvador8209"
          rel="noopener"
          class="site-footer__social-icon"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect>
            <path d="M10.5 9.5v5l4.3-2.5z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        Aluminios Cuzcatlán, S.A. de C.V. · Calle El Pedregal, local 29 G, Ciudad Merliot
      </p>
      <p class="site-footer__copy">© 2026 ALCUSA. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-10) var(--space-6) calc(var(--space-12) + env(safe-area-inset-bottom, 0px));
    /* Transparente: el degradado del body termina en --color-page-bottom justo aqui (sin costura). */
    background: transparent;
    border-top: 1px solid var(--color-line-on-dark);
    color: var(--color-footer-text);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--container-page, 1240px);
    margin: 0 auto;
    width: 100%;
  }
  .site-footer__row {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .site-footer__brand img {
    border-radius: 10px;
    display: block;
    object-fit: contain;
  }
  .site-footer__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .site-footer__wordmark {
    font-family: var(--font-family-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-display-semibold);
    color: var(--color-text-on-dark);
  }
  .site-footer__tagline {
    font-size: 0.75rem;
  }
  .site-footer__head {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-on-dark);
  }
  .site-footer__nav a,
  .site-footer__phones a {
    min-height: 44px;
    display: flex;
    align-items: center;
    align-self: flex-start;
    /* Pildora de hover: el padding se compensa con margen negativo para que el texto no se mueva. */
    padding-inline: var(--space-3);
    margin-inline: calc(-1 * var(--space-3));
    border-radius: var(--radius-full);
    color: var(--color-text-on-dark);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .site-footer__phones {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
  }
  .site-footer__whatsapp {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    border-radius: 14px;
    background: var(--color-whatsapp-strong);
    color: var(--color-text-on-dark);
    font-size: var(--font-size-body-mobile);
    font-weight: 600;
    text-decoration: none;
  }
  /* Hover como el navbar: relleno suave sobre pildora, sin elevacion ni sombra. */
  @media (hover: hover) and (pointer: fine) {
    .site-footer__nav a,
    .site-footer__phones a,
    .site-footer__social-icon,
    .site-footer__whatsapp {
      transition:
        background-color var(--hover-dur) var(--hover-ease),
        color var(--hover-dur) var(--hover-ease);
    }
    .site-footer__nav a:hover,
    .site-footer__phones a:hover,
    .site-footer__social-icon:hover {
      background: var(--color-surface-dark-raised);
      color: var(--color-text-on-dark);
    }
    .site-footer__whatsapp:hover {
      background: var(--color-whatsapp-strong-hover);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__nav a,
    .site-footer__phones a,
    .site-footer__social-icon,
    .site-footer__whatsapp {
      transition: none;
    }
  }
  .site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line-on-dark);
  }
  .site-footer__pay {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.875rem;
  }
  .site-footer__social {
    display: flex;
    gap: var(--space-2);
  }
  .site-footer__social-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-line-on-dark);
    color: var(--color-text-on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .site-footer__social-icon svg,
  .site-footer__whatsapp svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .site-footer__legal {
    margin: 0;
    font-size: 0.875rem;
  }
  .site-footer__copy {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-footer-muted);
  }
  .site-footer__nav a:focus-visible,
  .site-footer__phones a:focus-visible,
  .site-footer__social-icon:focus-visible,
  .site-footer__whatsapp:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus-on-dark);
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding: var(--space-14) var(--space-8) var(--space-10);
    }
    .site-footer__inner {
      gap: var(--space-8);
      /* Alinea con el navbar y el catalogo: columna de 1240 px menos el aire lateral (el pie no se estira al ancho de pagina). */
      max-width: calc(1240px - 2 * var(--space-8));
    }
    .site-footer__row {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-12);
    }
    .site-footer__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .site-footer__pay {
      flex-direction: row;
      gap: var(--space-3);
      align-items: baseline;
    }
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-4);
    }
    .site-footer__legal,
    .site-footer__copy {
      font-size: 0.875rem;
    }
  }
</style>
