---
// ComoFunciona — 4 pasos. Fuente de verdad: boards r01 (ios/android/desktop,
// revision-2026-09-29) #proceso. Sin lead, sin conectores ni insignias circulares:
// cada paso es una tarjeta (.st) con numero Fraunces, titulo y copy.
const STEPS = [
  { n: '01', title: 'Selecciona', copy: 'Elige el producto y el acabado para tu espacio.' },
  { n: '02', title: 'Cotiza', copy: 'Ingresa tus medidas y ve el precio al instante.' },
  { n: '03', title: 'Confirma', copy: 'Aparta tu pedido con un anticipo del 80%.' },
  { n: '04', title: 'Recibe', copy: 'Instalamos y pagas el 20% al entregar.' },
] as const;
---

<section id="proceso" class="proceso" aria-labelledby="proceso-title">
  <div class="proceso__wrap">
    <p class="proceso__kicker">Cómo funciona</p>
    <h2 id="proceso-title" class="proceso__title">Tu pedido, en cuatro pasos claros</h2>
    <ol class="proceso__list">
      {
        STEPS.map((step) => (
          <li class="proceso__step">
            <span class="proceso__step-number">{step.n}</span>
            <span class="proceso__step-title">{step.title}</span>
            <span class="proceso__step-copy">{step.copy}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proceso {
    padding: 0 var(--space-6) 56px;
  }
  .proceso__wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .proceso__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .proceso__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .proceso__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .proceso__step {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  .proceso__step-number {
    font-family: var(--font-family-display);
    font-size: 22px;
    font-weight: var(--font-weight-display-medium);
    line-height: 1.15;
    color: var(--color-accent);
  }
  .proceso__step-title {
    font-size: 16px;
    font-weight: var(--font-weight-body-bold);
    line-height: 1.3;
  }
  .proceso__step-copy {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }
  @media (max-width: 339px) {
    .proceso {
      padding-inline: var(--space-4);
    }
    .proceso__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 768px) {
    .proceso {
      padding-inline: 0;
    }
    .proceso__wrap {
      width: min(var(--container-page), 100% - 2 * var(--space-10));
      margin-inline: auto;
    }
  }
  @media (min-width: 1024px) {
    .proceso {
      padding-bottom: var(--space-30);
    }
    .proceso__wrap {
      gap: var(--space-4);
    }
    .proceso__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .proceso__title {
      margin-bottom: var(--space-6);
      font-size: 44px;
      line-height: 52px;
    }
    .proceso__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8);
    }
    .proceso__step {
      padding: var(--space-6);
      gap: var(--space-2);
    }
    .proceso__step-number {
      font-size: 28px;
    }
    .proceso__step-title {
      font-size: 20px;
      line-height: 28px;
    }
    .proceso__step-copy {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
