---
// ComoFunciona — 4-step trust strip (spec §1 item 2). Previously
// `display:none` in legacy; must render visibly on all 3 viewports (T3.2).
//
// Fidelity pass (sf-fidelity3): desktop-01-inicio.dc.html §proceso (~L78-89)
// is the source of truth — step 4's badge is filled solid (unlike 1-3), a
// dashed connector runs between badges 1→2→3→4 on desktop only, the lead
// copy "Sin visitas previas…" sits beside the title on desktop only (absent
// from both mobile boards), and desktop steps are flat (no card box/shadow) —
// only the mobile boards (Main.dc.html / android-01-inicio) keep the card
// look with --shadow-xs, which already matched pre-fix.
const STEPS = [
  { n: '01', title: 'Selecciona', copy: 'Elige el producto y el acabado para tu espacio.', filled: false },
  { n: '02', title: 'Cotiza', copy: 'Ingresa tus medidas y ve el precio al instante.', filled: false },
  { n: '03', title: 'Confirma', copy: 'Aparta tu pedido con un anticipo del 80%.', filled: false },
  { n: '04', title: 'Recibe', copy: 'Instalamos y pagas el 20% al entregar.', filled: true },
] as const;
---

<section id="proceso" class="proceso" aria-labelledby="proceso-title">
  <div class="proceso__inner">
    <div class="proceso__head">
      <div class="proceso__heading">
        <p class="proceso__kicker">C&oacute;mo funciona</p>
        <h2 id="proceso-title" class="proceso__title">Tu pedido, en cuatro pasos claros</h2>
      </div>
      <p class="proceso__lead">
        Sin visitas previas para saber el precio: cotizas en l&iacute;nea y confirmamos medidas antes de fabricar.
      </p>
    </div>
    <ol class="proceso__list">
      {
        STEPS.map((step, i) => (
          <li class="proceso__step">
            <div class="proceso__step-head">
              <span class:list={['proceso__step-number', { 'proceso__step-number--filled': step.filled }]}>
                {step.n}
              </span>
              {i < STEPS.length - 1 && <span class="proceso__step-connector" aria-hidden="true" />}
            </div>
            <span class="proceso__step-title">{step.title}</span>
            <span class="proceso__step-copy">{step.copy}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proceso {
    padding: var(--space-8) var(--space-6);
  }

  .proceso__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .proceso__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .proceso__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .proceso__kicker {
    margin: 0;
    font-size: var(--font-size-caption-mobile);
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .proceso__title {
    /* Board size (desktop-01-inicio ~L81, Main.dc.html/android ~L60/L63):
       30px/1.15 mobile, 56px/~1.15 desktop — bigger than the shared h2
       tokens (22px/28px) used by sibling sections, so this reuses the
       existing display-lg-mobile / display-xl-desktop tiers instead.
       No literal <br> in the boards' markup: text-wrap: balance at this
       size + the (already-matching) container width naturally wraps
       after "en", same as the board. */
    margin: 0;
    font-size: var(--font-size-display-lg-mobile);
    font-weight: var(--font-weight-display-medium);
    line-height: var(--font-line-height-display);
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* Lead copy only appears in the desktop board (§proceso ~L82); both mobile
     boards omit it entirely. */
  .proceso__lead {
    display: none;
  }

  .proceso__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .proceso__step {
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .proceso__step-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .proceso__step-number {
    font-family: var(--font-family-display);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--font-weight-display-medium);
    color: var(--color-accent);
    line-height: var(--font-line-height-display);
  }

  /* Filled (step 4) badge only exists in the desktop board — both mobile
     boards render step 4 identically to steps 1-3 — so the modifier is a
     no-op until the desktop media query below. */
  .proceso__step-connector {
    display: none;
  }

  .proceso__step-title {
    font-size: var(--font-size-body-mobile);
    font-weight: var(--font-weight-body-bold);
    line-height: var(--font-line-height-heading);
  }

  .proceso__step-copy {
    font-size: var(--font-size-body-sm-mobile);
    line-height: var(--font-line-height-body);
    color: var(--color-ink-muted);
  }

  @media (min-width: 1024px) {
    .proceso {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-soft);
      border-bottom: 1px solid var(--color-border-soft);
      padding: var(--space-24) var(--space-6);
    }

    .proceso__inner {
      max-width: var(--container-page);
      margin: 0 auto;
      gap: var(--space-16);
    }

    .proceso__head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-16);
    }

    .proceso__heading {
      width: 784px;
      gap: var(--space-4);
    }

    .proceso__title {
      font-size: var(--font-size-display-xl-desktop);
    }

    .proceso__lead {
      display: block;
      margin: 0;
      width: 520px;
      font-size: var(--font-size-body-lg-desktop);
      line-height: var(--font-line-height-body);
      color: var(--color-ink-muted);
      text-wrap: pretty;
    }

    .proceso__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .proceso__step {
      /* Flat on desktop — the board's steps have no card box/shadow, only
         the mobile boards do. */
      padding: 0;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
      gap: var(--space-3);
    }

    .proceso__step-head {
      margin-bottom: var(--space-3);
    }

    .proceso__step-number {
      width: var(--space-16);
      height: var(--space-16);
      flex-shrink: 0;
      border-radius: var(--radius-full);
      background: var(--color-surface-tint);
      color: var(--color-primary);
      font-size: var(--font-size-h3-desktop);
      font-weight: var(--font-weight-display-semibold);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .proceso__step-number--filled {
      background: var(--color-primary);
      color: var(--color-surface);
    }

    .proceso__step-connector {
      display: block;
      flex-grow: 1;
      border-top: 1.5px dashed var(--color-border-input);
    }

    .proceso__step-title {
      font-size: var(--font-size-h3-desktop);
    }

    .proceso__step-copy {
      font-size: var(--font-size-body-lg-desktop);
    }
  }
</style>
