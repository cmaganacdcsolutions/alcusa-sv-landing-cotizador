---
// Confianza — trust proof strip (spec §1 item 5). AÑOS and track-record are
// literal bracketed placeholders per client-questions.md #1/#2 — never a
// guessed number (T3.3 AC). Do not resolve silently once the client answers;
// file a follow-up task instead.
const ITEMS = [
  {
    icon: 'star',
    value: '4.2',
    valueSuffix: 'en Google',
    detail: '130 reseñas de clientes',
    placeholder: false,
  },
  {
    icon: 'clock',
    value: '[AÑOS — confirmar 35/39]',
    valueSuffix: 'años de experiencia',
    detail: 'en aluminio y vidrio',
    placeholder: true,
  },
  {
    icon: 'people',
    value: '[+10,000/+15,000 — confirmar]',
    valueSuffix: 'clientes satisfechos',
    detail: null,
    placeholder: true,
  },
  {
    icon: 'shield',
    value: '6 meses',
    valueSuffix: 'de garantía',
    detail: 'respaldo ALCUSA',
    placeholder: false,
  },
  {
    icon: 'truck',
    value: '8–10',
    valueSuffix: 'días hábiles de entrega',
    detail: 'tiempo estimado',
    placeholder: false,
  },
] as const;

const ICON_PATHS: Record<string, string> = {
  star: 'M12 4l2.4 5 5.4.7-4 3.7 1 5.4-4.8-2.6-4.8 2.6 1-5.4-4-3.7 5.4-.7z',
  clock: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17zM12 7.5V12l3 2',
  people: 'M9 8.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM3.5 19c.6-3 2.8-4.6 5.5-4.6s4.9 1.6 5.5 4.6M15.5 5.8a3 3 0 0 1 0 5.4M17.5 14.6c1.6.6 2.7 2 3 4.4',
  shield: 'M12 3.5l7 2.5v5.5c0 4.3-3 7.7-7 9-4-1.3-7-4.7-7-9V6zM9 12l2 2 4-4',
  truck: 'M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7M7 17.5a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6zM17 17.5a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6z',
};
---

<section id="confianza" class="confianza" aria-labelledby="confianza-title">
  <div class="confianza__inner">
    <p class="confianza__kicker">Confianza</p>
    <h2 id="confianza-title" class="confianza__title">Lo que nos respalda</h2>
    <ul class="confianza__list">
      {
        ITEMS.map((item) => (
          <li class="confianza__item">
            <span class="confianza__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path d={ICON_PATHS[item.icon]} />
              </svg>
            </span>
            <span class="confianza__copy">
              <span class="confianza__value">
                {item.placeholder ? <span class="confianza__placeholder">{item.value}</span> : item.value}{' '}
                {item.valueSuffix}
              </span>
              {item.detail && <span class="confianza__detail">{item.detail}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .confianza {
    padding: var(--space-8) var(--space-6);
  }

  .confianza__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .confianza__kicker {
    margin: 0;
    font-size: var(--font-size-caption-mobile);
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .confianza__title {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--font-weight-display-medium);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .confianza__list {
    margin: 0;
    padding: 0 var(--space-5);
    list-style: none;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    display: flex;
    flex-direction: column;
  }

  .confianza__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .confianza__item:last-child {
    border-bottom: none;
  }

  .confianza__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-surface-tint);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .confianza__copy {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }

  .confianza__value {
    font-size: var(--font-size-body-lg-mobile);
    font-weight: var(--font-weight-body-bold);
    color: var(--color-ink);
  }

  .confianza__placeholder {
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border-radius: var(--radius-xs);
    padding: 0 var(--space-2);
  }

  .confianza__detail {
    font-size: var(--font-size-body-sm-mobile);
    color: var(--color-ink-muted);
  }

  @media (min-width: 1024px) {
    .confianza {
      padding: var(--space-24) var(--space-6) var(--space-16);
    }

    .confianza__inner {
      max-width: var(--container-page);
      margin: 0 auto;
      gap: var(--space-8);
    }

    .confianza__title {
      font-size: var(--font-size-h2-desktop);
    }

    .confianza__list {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
    }

    .confianza__item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-8);
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }

    .confianza__item:last-child {
      border-right: none;
    }

    .confianza__icon {
      width: 48px;
      height: 48px;
    }

    .confianza__value {
      margin-top: var(--space-4);
      display: flex;
      flex-direction: column;
      font-size: var(--font-size-body-lg-desktop);
    }

    .confianza__detail {
      font-size: var(--font-size-body-sm-desktop);
    }
  }
</style>
