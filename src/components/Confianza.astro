---
// Confianza — fuente de verdad: boards r01 #confianza, con las cifras oficiales
// que ALCUSA confirmó el 2026-10-06 (38 años, +10,000 clientes, +10,000 puertas).
// Pulido 2026-10-06: tarjetas azul noche translucidas (mismo lenguaje que el resto del sitio), iconos en azul claro.
const ITEMS = [
  {
    icon: '<path d="M12 4l2.4 5 5.4.7-4 3.7 1 5.4-4.8-2.6-4.8 2.6 1-5.4-4-3.7 5.4-.7z"/>',
    title: '4.2 en Google',
    detail: '130 reseñas de clientes',
  },
  {
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
    title: 'Más de 38 años',
    detail: 'fabricando e instalando aluminio y vidrio',
  },
  {
    icon: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.5 14.2c2.5-.3 4.5 1.3 5 4.3"/>',
    title: '+10,000 clientes',
    detail: 'satisfechos',
  },
  {
    icon: '<rect x="6" y="3.5" width="12" height="17" rx="1"/><path d="M4 20.5h16"/><circle cx="14.8" cy="12" r=".9"/>',
    title: '+10,000 puertas',
    detail: 'instaladas o reemplazadas',
  },
  {
    icon: '<path d="M12 3.5l7 2.5v5.5c0 4.3-3 7.7-7 9-4-1.3-7-4.7-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
    title: '6 meses de garantía',
    detail: 'respaldo ALCUSA',
  },
  {
    icon: '<path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
    title: 'Entrega en 8–10 días hábiles',
    detail: 'tiempo estimado',
  },
] as const;
---

<section id="confianza" class="confianza" aria-labelledby="confianza-title">
  <div class="confianza__wrap">
    <p class="confianza__kicker">Confianza</p>
    <h2 id="confianza-title" class="confianza__title title-gradient">Lo que nos respalda</h2>
    <ul class="confianza__list">
      {
        ITEMS.map((item) => (
          <li class="confianza__item">
            <span class="confianza__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            </span>
            <span class="confianza__copy">
              <span class="confianza__value">{item.title}</span>
              <span class="confianza__detail">{item.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Mismo contenedor y ritmo que las secciones del catalogo (.csec): 1240 px, aire lateral 16/24/32. */
  .confianza {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
  }
  .confianza__wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .confianza__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-on-dark);
  }
  .confianza__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-bold);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-text-on-dark);
    text-wrap: balance;
  }
  .confianza__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-3);
  }
  /* Tarjeta azul noche (raised) sobre el degradado de la pagina, con linea fina clara. */
  .confianza__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    color: var(--color-text-on-dark);
    /* Opaco a proposito: el contraste AA no depende de lo que haya debajo (un fondo translucido sobre el degradado no es verificable). */
    background: var(--color-surface-dark-raised);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-line-on-dark);
    border-radius: var(--radius-lg);
  }
  .confianza__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--color-accent-on-dark);
    background: color-mix(in srgb, var(--color-accent-on-dark) 14%, transparent);
    border: 1px solid var(--color-line-on-dark);
  }
  .confianza__icon svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .confianza__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .confianza__value {
    font-size: 17px;
    font-weight: var(--font-weight-body-bold);
    color: var(--color-text-on-dark);
  }
  .confianza__detail {
    font-size: 14px;
    color: var(--color-text-on-dark-muted);
  }
  @media (min-width: 768px) {
    .confianza {
      padding-inline: var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .confianza {
      padding-inline: var(--space-8);
      padding-bottom: var(--space-16);
    }
    .confianza__wrap {
      gap: var(--space-4);
    }
    .confianza__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .confianza__title {
      margin-bottom: var(--space-4);
      font-size: 44px;
      line-height: 52px;
    }
    .confianza__list {
      gap: var(--space-6);
    }
    .confianza__item {
      padding: var(--space-5) var(--space-6);
      border-radius: var(--radius-xl);
    }
    .confianza__icon {
      width: 48px;
      height: 48px;
    }
    .confianza__value {
      font-size: 18px;
    }
    .confianza__detail {
      font-size: 15px;
    }
  }
</style>
