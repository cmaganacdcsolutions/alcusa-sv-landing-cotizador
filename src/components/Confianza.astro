---
// Confianza — fuente de verdad: boards r01 #confianza (4 items). AÑOS queda como
// placeholder literal entre corchetes (client-questions #1): nunca un numero inventado.
// El copy difiere por viewport igual que en los boards: movil "[AÑOS] años / de
// experiencia en aluminio y vidrio"; desktop "[AÑOS] / años de experiencia".
const ITEMS = [
  {
    icon: '<path d="M12 4l2.4 5 5.4.7-4 3.7 1 5.4-4.8-2.6-4.8 2.6 1-5.4-4-3.7 5.4-.7z"/>',
    title: '4.2 en Google',
    detail: '130 reseñas de clientes',
    placeholder: false,
  },
  {
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
    title: '[AÑOS — confirmar 35/39]',
    detail: '',
    placeholder: true,
  },
  {
    icon: '<path d="M12 3.5l7 2.5v5.5c0 4.3-3 7.7-7 9-4-1.3-7-4.7-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
    title: '6 meses de garantía',
    detail: 'respaldo ALCUSA',
    placeholder: false,
  },
  {
    icon: '<path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
    title: 'Entrega en 8–10 días hábiles',
    detail: 'tiempo estimado',
    placeholder: false,
  },
] as const;
---

<section id="confianza" class="confianza" aria-labelledby="confianza-title">
  <div class="confianza__wrap">
    <p class="confianza__kicker">Confianza</p>
    <h2 id="confianza-title" class="confianza__title">Lo que nos respalda</h2>
    <ul class="confianza__list">
      {
        ITEMS.map((item) => (
          <li class="confianza__item">
            <span class="confianza__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            </span>
            <span class="confianza__copy">
              <span class="confianza__value">
                {item.placeholder ? (
                  <>
                    <span class="confianza__placeholder">{item.title}</span>
                    <span class="confianza__m-only"> años</span>
                  </>
                ) : (
                  item.title
                )}
              </span>
              <span class="confianza__detail">
                {item.placeholder ? (
                  <>
                    <span class="confianza__d-only">años </span>de experiencia
                    <span class="confianza__m-only"> en aluminio y vidrio</span>
                  </>
                ) : (
                  item.detail
                )}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .confianza {
    padding: 0 var(--space-6) 56px;
  }
  .confianza__wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .confianza__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .confianza__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .confianza__list {
    margin: 0;
    padding: var(--space-2) var(--space-5);
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  .confianza__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .confianza__item:last-child {
    border-bottom: none;
  }
  .confianza__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-surface-tint);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .confianza__icon svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .confianza__copy {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
    min-width: 0;
  }
  .confianza__value {
    font-size: 17px;
    font-weight: var(--font-weight-body-bold);
  }
  .confianza__placeholder {
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border-radius: var(--radius-xs);
    padding: 0 6px;
  }
  .confianza__detail {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .confianza__d-only {
    display: none;
  }
  @media (max-width: 339px) {
    .confianza {
      padding-inline: var(--space-4);
    }
  }
  @media (min-width: 768px) {
    .confianza {
      padding-inline: 0;
    }
    .confianza__wrap {
      width: min(var(--container-page), 100% - 2 * var(--space-10));
      margin-inline: auto;
    }
  }
  @media (min-width: 1024px) {
    .confianza {
      padding-bottom: var(--space-30);
    }
    .confianza__wrap {
      gap: var(--space-4);
    }
    .confianza__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .confianza__title {
      margin-bottom: var(--space-6);
      font-size: 44px;
      line-height: 52px;
    }
    .confianza__list {
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8);
      background: none;
      border-radius: 0;
      box-shadow: none;
    }
    .confianza__item {
      padding: var(--space-6);
      gap: var(--space-4);
      border-bottom: none;
      background: var(--color-surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xs);
    }
    .confianza__icon {
      width: 48px;
      height: 48px;
    }
    .confianza__icon svg {
      width: 22px;
      height: 22px;
    }
    .confianza__value {
      font-size: 20px;
    }
    .confianza__detail {
      font-size: 15px;
    }
    .confianza__d-only {
      display: inline;
    }
    .confianza__m-only {
      display: none;
    }
  }
</style>
