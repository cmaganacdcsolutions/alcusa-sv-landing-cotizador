---
// Hero r01 (Revision 2026-09-29): kicker + H1 + lede + botones "Cotizar ahora" / "Ver catalogo"
// + figura con PhotoFrame (4:3 movil, 3:2 desktop, degradado solo en el tercio inferior).
// Fidelidad: 02-design/boards/revision-2026-09-29/{ios,android,desktop}-r01-landing-promos
// y 02-design/specs/image-frame-rule.md. Las tarjetas de categoria, la fila de confianza,
// el CTA de WhatsApp y la insignia de Google ya no estan en el board: salen.
import PhotoFrame from './PhotoFrame';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <figure class="hero__media">
    <PhotoFrame
      src="/images/hero-ventana-bilbao-800.webp"
      srcSet="/images/hero-ventana-bilbao-480.webp 480w, /images/hero-ventana-bilbao-800.webp 800w, /images/hero-ventana-bilbao-1200.webp 1200w, /images/hero-ventana-bilbao-1920.webp 1920w"
      sizes="(min-width: 1024px) 944px, 100vw"
      alt="Ventana Bilbao de aluminio y vidrio polarizado fabricada por ALCUSA"
      ratio="4/3"
      loading="eager"
      fetchPriority="high"
      className="hero__photo"
    >
      <div class="hero__grad"></div>
    </PhotoFrame>
    <figcaption class="hero__caption">Ventana Bilbao &middot; a tu medida</figcaption>
  </figure>

  <div class="hero__intro">
    <p class="hero__kicker"><span class="hero__kicker-rule" aria-hidden="true"></span>ALCUSA &middot; FABRICADO A TU MEDIDA</p>
    <h1 id="hero-title" class="hero__title">&iquest;Qu&eacute; quieres cambiar en tu casa hoy?</h1>
    <p class="hero__lede">
      Un ba&ntilde;o que se vea mejor, ventanas que renueven tus espacios o una puerta que te conecte con tu
      jard&iacute;n. En ALCUSA lo hacemos a tu medida.
    </p>
    <div class="hero__cta-row">
      <a href="/cotizador" class="hero__btn hero__btn--primary" data-hero-cta="cotizar">
        Cotizar ahora
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a href="/catalogo" class="hero__btn hero__btn--secondary" data-hero-cta="catalogo">Ver cat&aacute;logo</a>
    </div>
  </div>
</section>

<style>
  /* Movil (ios/android-r01): .sec padding 0 24, gap 16, padding-top 16. */
  .hero {
    padding: var(--space-4) var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__intro {
    display: contents;
  }

  .hero__kicker {
    order: 1;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-caption-mobile);
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }

  .hero__kicker-rule {
    display: none;
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .hero__title {
    order: 2;
    margin: 0;
    font-size: var(--font-size-hero-h1-mobile);
    font-weight: var(--font-weight-display-semibold);
    line-height: var(--font-line-height-display);
    color: var(--color-ink);
    background: linear-gradient(100deg, var(--color-ink) 0%, var(--color-primary) 55%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-wrap: balance;
  }

  .hero__lede {
    order: 3;
    margin: 0;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .hero__media {
    order: 4;
    margin: var(--space-1) 0 0;
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .hero__grad {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--gradient-hero-photo);
  }

  .hero__caption {
    position: absolute;
    z-index: 2;
    left: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.9);
    font-size: var(--font-size-caption-mobile);
    font-weight: var(--font-weight-body-semibold);
    line-height: 1.4;
    color: var(--color-ink);
  }

  .hero__cta-row {
    order: 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-1);
    padding-bottom: var(--space-8);
  }

  .hero__btn {
    min-height: 52px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: 16px;
    font-weight: var(--font-weight-body-bold);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__btn--primary {
    background: var(--color-primary);
    color: var(--color-surface);
    box-shadow: var(--shadow-btn-primary);
  }

  .hero__btn--secondary {
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  .hero__btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .hero__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Desktop (desktop-r01): figura absoluta a la derecha, 944 a 1920 (3:2), bloque de
     texto 784 x min 596 centrado vertical; padding 64 0 96. Bajo 1920 la figura escala
     con el viewport (49.17vw = 944/1920) y el texto cede el ancho. */
  @media (min-width: 1024px) {
    .hero {
      position: relative;
      display: block;
      padding: var(--space-16) 0 var(--space-24);
    }

    .hero__media {
      position: absolute;
      top: var(--space-10);
      right: 0;
      width: min(944px, 49.17vw);
      margin: 0;
      border-radius: var(--radius-xl) 0 0 var(--radius-xl);
      box-shadow: var(--shadow-lg);
    }

    .hero__media :global(.hero__photo) {
      aspect-ratio: 3 / 2 !important;
    }

    .hero__caption {
      left: var(--space-8);
      bottom: var(--space-8);
      padding: var(--space-2) var(--space-4);
      background: rgba(255, 255, 255, 0.92);
      font-size: 15px;
      line-height: 24px;
    }

    .hero__intro {
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      box-sizing: border-box;
      max-width: var(--container-page);
      margin: 0 auto;
      padding-inline: var(--space-6);
      width: 100%;
      min-height: 596px;
    }

    .hero__intro > * {
      width: min(784px, 100%);
      max-width: calc(100% - min(944px, 49.17vw) - var(--space-8));
    }

    .hero__kicker {
      font-size: 14px;
      line-height: 20px;
    }

    .hero__kicker-rule {
      display: block;
    }

    .hero__title {
      margin-top: var(--space-6);
      font-size: var(--font-size-hero-h1-desktop-md);
      line-height: var(--line-height-hero-h1-desktop-md);
      letter-spacing: var(--letter-spacing-display-tight);
    }

    .hero__lede {
      margin-top: 28px;
      font-size: var(--font-size-body-lg-desktop);
      line-height: 28px;
      max-width: min(620px, 100%);
    }

    .hero__cta-row {
      flex-direction: row;
      gap: var(--space-4);
      margin-top: var(--space-10);
      padding-bottom: 0;
    }

    .hero__btn {
      display: inline-flex;
      min-height: 60px;
      padding: 0 var(--space-8);
      gap: var(--space-2-5);
      font-size: var(--font-size-body-lg-desktop);
    }
  }

  @media (min-width: 1600px) {
    /* Board x=160: the 1600 container has no inner padding and the 784 column fits left of
       the figure at every width >= 1600 (right edge = 50vw - 16 < figure left 50.83vw). */
    .hero__intro {
      padding-inline: 0;
    }

    .hero__intro > * {
      max-width: none;
    }

    .hero__title {
      font-size: var(--font-size-display-2xl-desktop);
      line-height: var(--font-line-height-display-2xl-desktop);
    }
  }
</style>
