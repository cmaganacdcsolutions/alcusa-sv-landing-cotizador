---
// ContactoTeaser — "¿Tienes dudas sobre tu medida?". Fuente de verdad: boards r01
// ios/android #contacto (seccion propia tras "Información importante"). El board
// desktop r01 NO dibuja este bloque, asi que se oculta >= 1024 (los datos de contacto
// viven en el pie y en /contacto).
//
// NO se construye (ruling del Foreman): el FAB flotante de WhatsApp de android-r01 ni
// los 88 dp de padding inferior del pie android (ver REDLINE "FAB de WhatsApp" en
// android-r01-landing-promos.dc.html). No hay senal de plataforma confiable y iOS no
// tiene equivalente.
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();
---

<section id="contacto" class="contacto-teaser" aria-labelledby="contacto-teaser-title">
  <div class="contacto-teaser__box">
    <h3 id="contacto-teaser-title" class="contacto-teaser__title">¿Tienes dudas sobre tu medida?</h3>
    <p class="contacto-teaser__lead">Escríbenos o visita nuestro taller en Ciudad Merliot.</p>
    <div class="contacto-teaser__actions">
      <a href="/contacto" class="contacto-teaser__btn contacto-teaser__btn--secondary">Contacto</a>
      <a href={waHref} class="contacto-teaser__btn contacto-teaser__btn--whatsapp">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z" />
          <path d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-teaser {
    padding: 0 var(--space-6) 56px;
  }
  .contacto-teaser__box {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface-dark-raised);
    border: 1px solid var(--color-line-on-dark);
    color: var(--color-text-on-dark);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .contacto-teaser__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-bold);
    color: var(--color-text-on-dark);
    font-size: 22px;
    line-height: 1.3;
  }
  .contacto-teaser__lead {
    margin: 0 0 var(--space-2);
    font-size: 16px;
    color: var(--color-text-on-dark-muted);
  }
  .contacto-teaser__actions {
    display: flex;
    gap: var(--space-3);
  }
  .contacto-teaser__btn {
    flex: 1;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .contacto-teaser__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .contacto-teaser__btn--secondary {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }
  .contacto-teaser__btn--whatsapp {
    gap: var(--space-2);
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
  }
  /* Hover como el navbar: relleno suave, sin elevacion ni sombra. Claro -> acento claro; WhatsApp -> su hover. */
  @media (hover: hover) and (pointer: fine) {
    .contacto-teaser__btn {
      transition:
        background-color var(--hover-dur) var(--hover-ease),
        color var(--hover-dur) var(--hover-ease);
    }
    .contacto-teaser__btn--secondary:hover {
      background: var(--color-accent-on-dark);
    }
    .contacto-teaser__btn--secondary:active {
      background: var(--color-text-on-dark-muted);
    }
    .contacto-teaser__btn--whatsapp:hover {
      background: var(--color-whatsapp-strong-hover);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contacto-teaser__btn {
      transition: none;
    }
  }
  .contacto-teaser__btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus-on-dark);
  }
  @media (max-width: 339px) {
    .contacto-teaser {
      padding-inline: var(--space-4);
    }
  }
  @media (min-width: 768px) {
    .contacto-teaser {
      padding-inline: 0;
    }
    .contacto-teaser__box {
      width: min(var(--container-page), 100% - 2 * var(--space-10));
      margin-inline: auto;
    }
  }
  @media (min-width: 1024px) {
    /* desktop-r01 no dibuja el bloque de contacto. */
    .contacto-teaser {
      display: none;
    }
  }
</style>
