---
// ContactoTeaser — "¿Tienes dudas sobre tu medida?" card (spec §1 item 7).
//
// Fidelity pass (sf-fidelity3): desktop-01-inicio.dc.html nests this
// <aside id="contacto"> INSIDE the same <section id="info"> as "Antes de
// comprar" (~L186-207) — it is the fixed 648px second column of that
// section's grid, not its own top-level section. InfoImportante.astro now
// imports and renders this component as that second column; keep this a
// standalone fragment (no outer <section>, no page-level padding/max-width —
// InfoImportante owns that). Both mobile boards (Main.dc.html L139-154,
// android-01-inicio) still render it as its own full-width stacked block
// directly below "Antes de comprar" — the mobile styles below already match
// that (single column, own card).
//
// The full contact webform now lives on its own route (/contacto, S5 page
// split).
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();
---

<aside id="contacto" class="contacto-teaser" aria-labelledby="contacto-teaser-title">
  <h3 id="contacto-teaser-title" class="contacto-teaser__title">¿Tienes dudas sobre tu medida?</h3>
  <p class="contacto-teaser__lead">Escríbenos o visita nuestro taller en Ciudad Merliot.</p>
  <div class="contacto-teaser__actions">
    <a href="/contacto" class="contacto-teaser__btn contacto-teaser__btn--secondary">Contacto</a>
    <a href={waHref} class="contacto-teaser__btn contacto-teaser__btn--whatsapp">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z" />
        <path d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z" />
      </svg>
      WhatsApp
    </a>
  </div>
  <ul class="contacto-teaser__details">
    <li class="contacto-teaser__detail">
      <span class="contacto-teaser__detail-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
          <circle cx="12" cy="10" r="2.3" />
        </svg>
      </span>
      Calle El Pedregal, local 29 G, Ciudad Merliot
    </li>
    <li class="contacto-teaser__detail">
      <span class="contacto-teaser__detail-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.5 3.5h3l1.5 4-2 1.2a11 11 0 0 0 6.3 6.3l1.2-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2z" />
        </svg>
      </span>
      Teléfonos 2278-2460 · 2208-4101 · 2563-7742
    </li>
    <li class="contacto-teaser__detail contacto-teaser__detail--whatsapp">
      <span class="contacto-teaser__detail-icon contacto-teaser__detail-icon--whatsapp" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z" />
          <path d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z" />
        </svg>
      </span>
      WhatsApp 7680-2410
    </li>
  </ul>
</aside>

<style>
  .contacto-teaser {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface-tint);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contacto-teaser__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: var(--font-size-h2-mobile);
    line-height: var(--font-line-height-heading);
  }

  .contacto-teaser__lead {
    margin: 0 0 var(--space-2);
    color: var(--color-ink-muted);
  }

  .contacto-teaser__actions {
    display: flex;
    gap: var(--space-3);
  }

  .contacto-teaser__btn {
    flex: 1;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-body-medium);
    text-decoration: none;
  }

  .contacto-teaser__btn--secondary {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }

  .contacto-teaser__btn--whatsapp {
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
  }

  .contacto-teaser__btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .contacto-teaser__details {
    display: none;
  }

  @media (min-width: 1024px) {
    .contacto-teaser {
      padding: var(--space-12);
      border-radius: var(--radius-xl);
      gap: var(--space-4);
    }

    .contacto-teaser__title {
      font-size: var(--font-size-display-sm-desktop);
      line-height: var(--font-line-height-heading);
    }

    .contacto-teaser__lead {
      font-size: var(--font-size-body-lg-desktop);
    }

    .contacto-teaser__actions {
      margin-top: var(--space-4);
    }

    .contacto-teaser__btn {
      min-height: 56px;
      flex: 0 0 auto;
      padding: 0 var(--space-6);
    }

    .contacto-teaser__details {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin: var(--space-4) 0 0;
      padding: var(--space-6) 0 0;
      list-style: none;
      border-top: 1px solid var(--color-border-input);
      font-size: var(--font-size-body-sm-desktop);
      color: var(--color-ink-muted);
    }

    .contacto-teaser__detail {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .contacto-teaser__detail-icon {
      color: var(--color-primary);
      display: flex;
      flex-shrink: 0;
    }

    .contacto-teaser__detail-icon--whatsapp {
      color: var(--color-whatsapp-strong);
    }
  }
</style>
