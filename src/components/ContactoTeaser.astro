---
// ContactoTeaser — landing "¿Tienes dudas sobre tu medida?" CTA card
// (Main.dc.html #contacto, desktop-01-inicio #contacto). The full contact
// webform now lives on its own route (/contacto, S5 page split).
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();
---

<section id="contacto" class="contacto-teaser" aria-labelledby="contacto-teaser-title">
  <div class="contacto-teaser__card">
    <h3 id="contacto-teaser-title" class="contacto-teaser__title">¿Tienes dudas sobre tu medida?</h3>
    <p class="contacto-teaser__lead">Escríbenos o visita nuestro taller en Ciudad Merliot.</p>
    <div class="contacto-teaser__actions">
      <a href="/contacto" class="contacto-teaser__btn contacto-teaser__btn--secondary">Contacto</a>
      <a href={waHref} class="contacto-teaser__btn contacto-teaser__btn--whatsapp">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z" />
          <path d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-teaser {
    padding: var(--space-6);
  }

  .contacto-teaser__card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-surface-tint);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contacto-teaser__title {
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: var(--font-size-h3-mobile);
    line-height: var(--font-line-height-heading);
  }

  .contacto-teaser__lead {
    margin: 0 0 var(--space-2);
    color: var(--color-ink-muted);
  }

  .contacto-teaser__actions {
    display: flex;
    gap: var(--space-3);
  }

  .contacto-teaser__btn {
    flex: 1;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-body-medium);
    text-decoration: none;
  }

  .contacto-teaser__btn--secondary {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }

  .contacto-teaser__btn--whatsapp {
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
  }

  .contacto-teaser__btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  @media (min-width: 1024px) {
    .contacto-teaser {
      max-width: var(--container-page);
      margin: 0 auto;
      padding: var(--space-8) var(--space-6) var(--space-24);
    }

    .contacto-teaser__card {
      padding: var(--space-12);
      gap: var(--space-4);
    }

    .contacto-teaser__title {
      font-size: var(--font-size-display-lg-desktop);
    }

    .contacto-teaser__lead {
      font-size: var(--font-size-body-lg-desktop);
    }

    .contacto-teaser__actions {
      margin-top: var(--space-4);
      max-width: 480px;
    }

    .contacto-teaser__btn {
      min-height: 56px;
      flex: 0 0 auto;
      padding: 0 var(--space-6);
    }
  }
</style>
