---
// TopBar — static component, no business logic, no hardcoded wa.me (README §4).
// NOT sticky: it scrolls away with the page content (T1.1 AC).
import { buildWaLink } from '@integrations/whatsapp/waLink';

const waHref = buildWaLink();
---

<header class="top-bar">
  <button
    type="button"
    id="drawer-open-btn"
    class="top-bar__icon-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="drawer-panel"
    aria-label="Abrir menú"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M4 7h16M4 12h16M4 17h10"></path></svg
    >
  </button>
  <a href="#inicio" class="top-bar__wordmark" aria-label="ALCUSA, inicio">
    <img src="/images/logo-primary.png" alt="" width="30" height="30" class="top-bar__logo" />
    <span class="top-bar__brand">Alcusa</span>
  </a>
  <a href={waHref} class="top-bar__icon-btn top-bar__icon-btn--whatsapp" aria-label="Escribir por WhatsApp">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M4.5 19.5l1.2-3.6a8 8 0 1 1 2.9 2.6z"></path><path
        d="M9.3 8.7c.4 2.6 3.2 5.4 6 6l1.1-1.4-1.8-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-1.8z"
      ></path></svg
    >
  </a>
</header>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 var(--space-3);
  }

  .top-bar__icon-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .top-bar__icon-btn--whatsapp {
    border-radius: var(--radius-full);
    background: var(--color-whatsapp-strong);
    color: var(--color-surface);
  }

  .top-bar__wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary);
    text-decoration: none;
  }

  .top-bar__logo {
    border-radius: var(--radius-xs);
    display: block;
  }

  .top-bar__brand {
    font-family: var(--font-family-display);
    font-size: 1.3125rem;
    font-weight: var(--font-weight-display-semibold);
  }

  @media (min-width: 1024px) {
    .top-bar {
      height: 80px;
      padding: 0 var(--space-8);
    }
  }
</style>
