---
// InfoImportante — fuente de verdad: boards r01 #info (4 items, sin iconos).
// Copy unico para 80/20 y exclusion AMEX: el paso de pago del cotizador debe reusar
// estas mismas cadenas (T3.4) — no bifurcar.
// La fila "Tasa 0%" (placeholder) NO esta en los boards r01: fuera de la UI hasta que el
// cliente confirme. El bloque "¿Tienes dudas...?" es una seccion aparte (ContactoTeaser,
// solo movil en los boards).
const ITEMS = [
  { title: 'Anticipo 80% · saldo 20%', detail: 'Pagas el 20% restante al recibir tu producto.' },
  { title: 'Pago con tarjeta vía Wompi', detail: 'Crédito y débito, excepto American Express.' },
  { title: 'Factura o crédito fiscal', detail: 'Indícalo al confirmar tu pedido.' },
  { title: 'Retiro en tienda −15%', detail: 'Aplica a puertas de baño rectas, sin transporte.' },
] as const;
---

<section id="info" class="info" aria-labelledby="info-title">
  <div class="info__wrap">
    <p class="info__kicker">Antes de comprar</p>
    <h2 id="info-title" class="info__title">Información importante</h2>
    <ul class="info__list">
      {
        ITEMS.map((item) => (
          <li class="info__item">
            <span class="info__item-title">{item.title}</span>
            <span class="info__detail">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .info {
    padding: 0 var(--space-6) 56px;
  }
  .info__wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .info__kicker {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    font-weight: var(--font-weight-body-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .info__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-display-medium);
    font-size: 30px;
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .info__list {
    margin: 0;
    padding: var(--space-1) var(--space-5);
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  .info__item {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    line-height: 1.45;
  }
  .info__item:last-child {
    border-bottom: none;
  }
  .info__item-title {
    font-size: 16px;
    font-weight: var(--font-weight-body-bold);
  }
  .info__detail {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  @media (max-width: 339px) {
    .info {
      padding-inline: var(--space-4);
    }
  }
  @media (min-width: 768px) {
    .info {
      padding-inline: 0;
    }
    .info__wrap {
      width: min(var(--container-page), 100% - 2 * var(--space-10));
      margin-inline: auto;
    }
  }
  @media (min-width: 1024px) {
    .info {
      padding-bottom: var(--space-24);
    }
    .info__wrap {
      gap: var(--space-4);
    }
    .info__kicker {
      font-size: 14px;
      line-height: 20px;
    }
    .info__title {
      margin-bottom: var(--space-6);
      font-size: 44px;
      line-height: 52px;
    }
    .info__list {
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
      background: none;
      border-radius: 0;
      box-shadow: none;
    }
    .info__item {
      padding: var(--space-6);
      gap: var(--space-1);
      line-height: 1.55; /* r01 desktop: 18/27.9 y 16/24.8 */
      border-bottom: none;
      background: var(--color-surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xs);
    }
    .info__item-title {
      font-size: 18px;
    }
    .info__detail {
      font-size: 16px;
    }
  }
</style>
