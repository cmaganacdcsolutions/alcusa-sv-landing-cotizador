---
// /cotizador — standalone cotizador route (spec §1 item 6, page split S5).
// Same shell as the landing (TopBar/Drawer/Footer); the Cotizador island
// reads `?producto=` from the URL to preselect step 0 (S6 territory —
// import only, do not edit src/islands/Cotizador/**).
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Cotizador from '@islands/Cotizador/Cotizador';
---

<BaseLayout
  title="Cotizador en línea de puertas y ventanas de vidrio | Alcusa"
  description="Cotiza en línea tus puertas de baño, puertas de jardín y ventanas de aluminio y vidrio a la medida. Precio al instante y confirmación por WhatsApp con Alcusa."
>
  <Navbar variant="compact" />

  <main id="main" tabindex="-1">
    <section id="cotizador-app" class="cotizador-page">
      <h1 class="visually-hidden">Cotizador en línea</h1>
      <Cotizador client:load />
    </section>
  </main>
</BaseLayout>

<style is:global>
  .cotizador-page {
    padding: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
