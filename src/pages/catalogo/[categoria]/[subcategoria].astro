---
// /catalogo/<categoria>/<subcategoria> (R2, boards r06): detail with the sticky
// price panel. Variants (En L finishes) have no route; they are chips here
// (ADR-008 §4). States: A priced, B advisorOnly (no $), C no photo.
import CatalogShell from '@components/catalog/CatalogShell.astro';
import CatalogMedia from '@components/catalog/CatalogMedia.astro';
import Arrow from '@components/catalog/Arrow.astro';
import WhatsAppIcon from '@components/catalog/WhatsAppIcon.astro';
import { CATEGORIES, formatFromPrice, hasVariants, type Category, type Subcategory } from '@content/catalog';
import { contentFor } from '@content/catalogContent';
import { assertCatalogForBuild } from '@content/catalogBuild';
import { cotizadorHref } from '@content/deepLink';
import { MORE_OPTIONS_GROUP, chipLabel, defaultVariant, detailTitle, primaryImage, priceView } from '@content/catalogView';
import { buildCatalogAdvisorMessage } from '@integrations/whatsapp/buildMessage';
import { buildWaLink } from '@integrations/whatsapp/waLink';

export function getStaticPaths() {
  return CATEGORIES.flatMap((category) =>
    category.subcategories.map((subcategory) => ({
      params: { categoria: category.slug, subcategoria: subcategory.slug },
      props: { category, subcategory },
    })),
  );
}
interface Props {
  category: Category;
  subcategory: Subcategory;
}
assertCatalogForBuild();
const { category, subcategory } = Astro.props;
const content = contentFor(subcategory.slug);
const title = detailTitle(subcategory);
const variants = hasVariants(subcategory) ? subcategory.variants : [];
const selected = defaultVariant(variants);
const advisor = subcategory.advisorOnly === true;
const price = priceView(subcategory);
const shownPrice = selected ? formatFromPrice(selected.fromPrice as number) : price.kind === 'from' ? price.text : '';
const ctaSlug = selected?.slug ?? subcategory.slug;
const ctaHref = advisor ? buildWaLink(buildCatalogAdvisorMessage(subcategory.name)) : cotizadorHref(ctaSlug);
const kicker = `${category.name}${subcategory.group === MORE_OPTIONS_GROUP ? ' · Más opciones' : ''}`.toLocaleUpperCase('es');
const baseImage = primaryImage(subcategory.slug);
const variantMedia = variants.flatMap((v) => {
  const img = primaryImage(v.slug);
  return img ? [{ slug: v.slug, img }] : [];
});
const ctaLabel = advisor ? 'Cotizar por WhatsApp' : 'Cotizar este producto';
const ctaTarget = advisor ? '_blank' : undefined;
const ctaRel = advisor ? 'noopener noreferrer' : undefined;
---

<CatalogShell
  title={`${title} | ${category.name} | ALCUSA`}
  description={content.description ?? `${title}: ${category.name} de aluminio y vidrio a la medida.`}
  backTo={{ label: category.name, href: `/catalogo/${category.slug}` }}
  crumbs={[
    { label: 'Catálogo', href: '/catalogo' },
    { label: category.name, href: `/catalogo/${category.slug}` },
    { label: subcategory.name },
  ]}
>
  <div class="cat-detail" data-detail>
    <div class:list={['cat-detail__media', { 'cat-detail__media--flat': advisor }]} data-media="base">
      <CatalogMedia image={baseImage} ratio="4/5" ratioLg="1/1" kind="detail" eager />
    </div>
    {
      variantMedia.map(({ slug, img }) => (
        <div class:list={['cat-detail__media', { 'cat-detail__media--flat': advisor }]} data-media={slug} hidden>
          <CatalogMedia image={img} ratio="4/5" ratioLg="1/1" kind="detail" />
        </div>
      ))
    }

    <aside class="cat-panel" aria-label="Precio y cotización">
      <p class="cat-kicker">{kicker}</p>
      <h1 class="cat-h1">{title}</h1>
      {content.description && <p class="cat-panel__desc">{content.description}</p>}

      {
        advisor ? (
          <div class="cat-advisor-box" data-testid="catalogo-asesor">
            <WhatsAppIcon size={24} full={false} />
            <span>Cotiza con un asesor</span>
          </div>
        ) : price.kind === 'pending' ? (
          <div class="cat-price">
            <span class="cat-price__from">Desde</span>
            <span class="cat-am">[$ — lo calcula el motor]</span>
          </div>
        ) : (
          <>
            <div class="cat-price" data-testid="catalogo-precio">
              <span class="cat-price__from">Desde</span>
              <span class="cat-price__amount" data-price>
                {shownPrice}
              </span>
            </div>
            <p class="cat-note">Precio de referencia con las medidas mínimas. El total final lo calculas en el cotizador.</p>
          </>
        )
      }

      {
        variants.length > 0 && (
          <>
            <p class="cat-label" id="vidrio-label">
              Elige tu vidrio
            </p>
            <div class="cat-options" role="group" aria-labelledby="vidrio-label">
              {variants.map((v) => (
                <button
                  type="button"
                  class="cat-option"
                  aria-pressed={v.slug === selected?.slug ? 'true' : 'false'}
                  data-variant={v.slug}
                  data-price-text={v.advisorOnly ? '' : formatFromPrice(v.fromPrice)}
                  data-href={cotizadorHref(v.slug)}
                >
                  {chipLabel(v)}
                </button>
              ))}
            </div>
          </>
        )
      }

      {
        content.specs && content.specs.length > 0 && (
          <dl class="cat-specs" data-testid="catalogo-specs">
            {content.specs.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        )
      }

      <a
        class:list={['cat-btn', 'cat-panel__cta', { 'cat-btn--wa': advisor }]}
        data-testid="catalogo-cta"
        data-cta
        href={ctaHref}
        target={ctaTarget}
        rel={ctaRel}
      >
        {advisor && <WhatsAppIcon size={22} />}
        {ctaLabel}
        {!advisor && <Arrow />}
      </a>
    </aside>
  </div>

  <div class="cat-bar">
    <a
      class:list={['cat-btn', { 'cat-btn--wa': advisor }]}
      data-testid="catalogo-cta-bar"
      data-cta
      href={ctaHref}
      target={ctaTarget}
      rel={ctaRel}
    >
      {advisor && <WhatsAppIcon size={20} />}
      {ctaLabel}
      {!advisor && <Arrow />}
    </a>
  </div>
</CatalogShell>

<script>
  // Finish chips: switch price, CTA deep link and (when the data has one) the photo.
  const root = document.querySelector<HTMLElement>('[data-detail]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-variant]'));
  if (root && buttons.length > 0) {
    const medias = Array.from(root.querySelectorAll<HTMLElement>('[data-media]'));
    const priceEl = root.querySelector<HTMLElement>('[data-price]');
    const ctas = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-cta]'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (priceEl && btn.dataset.priceText) priceEl.textContent = btn.dataset.priceText;
        const href = btn.dataset.href;
        if (href) ctas.forEach((a) => (a.href = href));
        const own = medias.some((m) => m.dataset.media === btn.dataset.variant);
        medias.forEach((m) => {
          m.hidden = m.dataset.media !== (own ? btn.dataset.variant : 'base');
        });
      });
    });
  }
</script>
