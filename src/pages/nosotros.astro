---
// /nosotros (navbar spec 01d §3, §13, §14). Contenido oficial de Alcusa (recibido 2026-10-14), textual.
// "Quiénes somos" solo usa hechos del material (Alcusa no envió una historia); conserva id="historia" por anclas.
// Fotos del taller: PhotoFrame estático (foto completa + capa ambiental horneada), sin hidratar islas.
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Confianza from '@components/Confianza.astro';
import Footer from '@components/Footer.astro';
import PhotoFrame from '@components/PhotoFrame';

const LEMA = 'Más de 39 años transformando espacios con calidad, confianza e innovación.';
const MISION = [
  'Brindar soluciones innovadoras, funcionales y de alta calidad en la fabricación e instalación de productos de aluminio y vidrio, transformando los espacios de nuestros clientes con diseños modernos, precios competitivos y un servicio personalizado.',
  'En ALCUSA, nos comprometemos a ofrecer productos duraderos, instalaciones profesionales y una experiencia de compra confiable, respaldada por más de 39 años de trayectoria, buscando siempre la satisfacción y confianza de nuestros clientes.',
] as const;
const VISION = [
  'Ser la empresa líder y referente en El Salvador en la fabricación, comercialización e instalación de productos de aluminio y vidrio, reconocida por nuestra calidad, innovación, excelencia en el servicio y compromiso con nuestros clientes.',
  'Aspiramos a expandir nuestra presencia a nivel nacional, incorporando nuevas tecnologías, procesos automatizados y plataformas digitales que faciliten la compra de nuestros productos, llevando las soluciones de ALCUSA a más hogares, empresas y proyectos.',
] as const;
const VALUES = [
  { title: 'Calidad', text: 'Garantizamos productos resistentes, funcionales y con excelentes acabados.' },
  { title: 'Compromiso', text: 'Trabajamos para cumplir las expectativas de nuestros clientes.' },
  { title: 'Innovación', text: 'Incorporamos tecnología y nuevos procesos para mejorar nuestros servicios.' },
  { title: 'Responsabilidad', text: 'Cumplimos nuestros compromisos con profesionalismo.' },
  { title: 'Honestidad', text: 'Promovemos relaciones comerciales basadas en la transparencia.' },
  { title: 'Trabajo en equipo', text: 'Valoramos a nuestros colaboradores como parte fundamental de nuestro crecimiento.' },
  { title: 'Orientación al cliente', text: 'Buscamos brindar una experiencia de compra satisfactoria de principio a fin.' },
] as const;
// Dirección ejecutiva: gráfica oficial de Alcusa (2026-10-14), mostrada completa y sin alterar (diseño de Alcusa).
// Va en public/images/direccion (no en fotos/: no es una foto, no lleva capa ambiental). Su texto no es legible para lectores de pantalla: se repite en una lista visually-hidden.
const DIRECCION = [
  { name: 'Rutilio Galdámez', role: 'Economista, Fundador y Visionario', roleEn: 'Founder & Visionary', extra: null },
  {
    name: 'Francisco Galdámez',
    role: 'Director de Operaciones y Logística',
    roleEn: 'COO – Chief Operating Officer',
    extra: 'Coordinación de Entregas e Instalaciones',
  },
  {
    name: 'Ricardo Galdámez',
    role: 'Director Ejecutivo, Mercadeo y Ventas',
    roleEn: 'CEO & CMO',
    extra: 'Community Manager',
  },
] as const;
const DIRECCION_ALT = 'Dirección ejecutiva de Alcusa: Rutilio, Francisco y Ricardo Galdámez';
const DIRECCION_IMG = '/images/direccion/direccion-ejecutiva';
---

<BaseLayout
  title="Nosotros | ALCUSA"
  description="Conoce a ALCUSA: quiénes somos, nuestra misión, visión y valores en aluminio y vidrio a la medida en El Salvador."
>
  <Navbar />

  <main id="main" tabindex="-1">
    <section class="nos nos__hero" aria-labelledby="nos-title">
      <p class="nos__kicker">ALCUSA</p>
      <h1 id="nos-title" class="nos__h1">Nosotros</h1>
      <p class="nos__lema">{LEMA}</p>
    </section>

    <section id="historia" class="nos nos__split" aria-labelledby="historia-t">
      <div>
        <h2 id="historia-t" class="nos__h2">Quiénes somos</h2>
        <p class="nos__p">
          Aluminios Cuscatlán, S.A. de C.V. (ALCUSA) cuenta con más de 39 años de trayectoria en la fabricación,
          comercialización e instalación de productos de aluminio y vidrio en El Salvador.
        </p>
        <figure id="direccion" class="nos__dir">
          <h3 class="sr-only">Nuestra dirección ejecutiva</h3>
          <a
            class="nos__dir-link"
            href={`${DIRECCION_IMG}-1600.webp`}
            target="_blank"
            rel="noopener"
            aria-label="Abrir la gráfica de la dirección ejecutiva en tamaño completo (se abre en una pestaña nueva)"
          >
            <img
              src={`${DIRECCION_IMG}-1200.webp`}
              srcset={`${DIRECCION_IMG}-800.webp 800w, ${DIRECCION_IMG}-1200.webp 1200w, ${DIRECCION_IMG}-1600.webp 1600w`}
              sizes="(min-width: 1024px) 570px, calc(100vw - 32px)"
              alt={DIRECCION_ALT}
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption class="sr-only">
            <ul>
              {
                DIRECCION.map((d) => (
                  <li>
                    {d.name}: {d.role} ({d.roleEn}){d.extra ? `; ${d.extra}` : ''}
                  </li>
                ))
              }
            </ul>
          </figcaption>
          <p class="nos__dir-hint">Toca la imagen para verla en grande</p>
        </figure>
      </div>
      <div class="nos__photo">
        <PhotoFrame
          src="/images/fotos/taller-alcusa-aereo-1536.webp"
          srcSet="/images/fotos/taller-alcusa-aereo-800.webp 800w, /images/fotos/taller-alcusa-aereo-1536.webp 1536w"
          sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
          alt="Vista aérea del taller de ALCUSA en El Salvador"
          ratio="3/2"
          width={1536}
          height={1024}
        />
      </div>
    </section>

    <section class="nos nos__mv" aria-label="Misión y visión">
      <article id="mision" class="nos__card nos__mision" aria-labelledby="mision-t">
        <h2 id="mision-t" class="nos__h2">Misión</h2>
        {MISION.map((t) => <p class="nos__p">{t}</p>)}
      </article>
      <article id="vision" class="nos__card nos__vision" aria-labelledby="vision-t">
        <h2 id="vision-t" class="nos__h2">Visión</h2>
        {VISION.map((t) => <p class="nos__p">{t}</p>)}
      </article>
      <div class="nos__photo nos__photo--tall">
        <PhotoFrame
          src="/images/fotos/taller-alcusa-aereo-doble-1080.webp"
          srcSet="/images/fotos/taller-alcusa-aereo-doble-800.webp 800w, /images/fotos/taller-alcusa-aereo-doble-1080.webp 1080w"
          sizes="(min-width: 1024px) 480px, (min-width: 768px) 420px, calc(100vw - 32px)"
          alt="Dos tomas aéreas del taller y las instalaciones de ALCUSA en El Salvador"
          ratio="4/5"
          width={1080}
          height={1440}
        />
      </div>
    </section>

    <section id="valores" class="nos" aria-labelledby="valores-t">
      <h2 id="valores-t" class="nos__h2">Valores</h2>
      <ul class="nos__values">
        {
          VALUES.map((v) => (
            <li class="nos__card">
              <p class="nos__vt">{v.title}</p>
              <p class="nos__p">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="nos__trust">
      <Confianza />
    </div>

    <section class="nos nos__cta" aria-labelledby="nos-cta-t">
      <h2 id="nos-cta-t" class="nos__h2">¿Listo para cotizar tu proyecto?</h2>
      <a class="nos__btn" href="/cotizador">Cotizar ahora</a>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .nos {
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) 0;
    display: grid;
    gap: var(--space-4);
  }
  .nos__hero {
    padding-top: var(--space-6);
  }
  .nos__kicker {
    margin: 0;
    font: var(--font-weight-body-bold) 12px/16px var(--font-family-body);
    letter-spacing: 0.08em;
    color: var(--color-accent-on-dark);
  }
  .nos__h1 {
    margin: 0;
    font-size: 32px;
    line-height: 40px;
    font-weight: var(--font-weight-display-bold);
    color: var(--color-text-on-dark);
  }
  .nos__h2 {
    margin: 0;
    font-size: 26px;
    line-height: 32px;
    font-weight: var(--font-weight-display-bold);
    color: var(--color-text-on-dark);
  }
  .nos__lema,
  .nos__p {
    margin: 0;
    color: var(--color-text-on-dark-muted);
    font: 400 16px/26px var(--font-family-body);
  }
  .nos__lema {
    max-width: 60ch;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-text-on-dark);
  }
  .nos__split,
  .nos__mv {
    grid-template-columns: minmax(0, 1fr);
  }
  .nos__split > div {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .nos__photo {
    min-width: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .nos__photo--tall {
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }
  .nos__card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    background: var(--color-surface-dark-raised);
    border: 1px solid var(--color-line-on-dark);
    color: var(--color-text-on-dark);
    border-radius: var(--radius-lg);
  }
  .nos__values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  .nos__vt {
    margin: 0;
    font-weight: var(--font-weight-body-bold);
  }
  /* Grafica oficial completa (16:9, sin recorte, sin filtros); marco sobrio como las fotos de la pagina. */
  .nos__dir {
    margin: var(--space-2) 0 0;
    min-width: 0;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
  }
  .nos__dir-link {
    display: block;
    width: 100%;
    max-width: 1600px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    line-height: 0;
  }
  .nos__dir-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus-on-dark);
  }
  .nos__dir img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .nos__dir-hint {
    margin: 0;
    font: 400 13px/18px var(--font-family-body);
    color: var(--color-text-on-dark-muted);
  }
  /* Confianza no trae aire superior (en el inicio sigue al catalogo): aqui separa de Valores. */
  .nos__trust {
    padding-top: var(--space-10);
  }
  .nos__cta {
    justify-items: start;
    padding-bottom: var(--space-12);
  }
  .nos__btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-text-on-dark);
    color: var(--color-surface-dark);
    font: var(--font-weight-body-bold) 15px/20px var(--font-family-body);
    text-decoration: none;
  }
  /* Hover como .nav__cta: relleno suave (acento claro; activo: gris azulado), sin elevacion ni sombra. */
  @media (hover: hover) and (pointer: fine) {
    .nos__btn {
      transition:
        background-color var(--hover-dur) var(--hover-ease),
        color var(--hover-dur) var(--hover-ease);
    }
    .nos__btn:hover {
      background: var(--color-accent-on-dark);
    }
    .nos__btn:active {
      background: var(--color-text-on-dark-muted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nos__btn {
      transition: none;
    }
  }
  .nos__btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus-on-dark);
  }
  @media (min-width: 768px) {
    .nos__values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 7 valores: la ultima ocupa el ancho restante (sin fila huerfana). */
    .nos__values > li:last-child {
      grid-column: 1 / -1;
    }
    .nos__mv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nos__photo--tall {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .nos {
      padding: var(--space-12) var(--space-8) 0;
    }
    .nos__split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
      align-items: stretch;
    }
    /* Columna izquierda (texto + grafica) manda la altura; la foto aerea la acompana: el marco se estira y la foto
       sigue completa (contain) sobre su capa ambiental, sin recorte ni huecos. */
    .nos__split > .nos__photo {
      position: relative;
    }
    .nos__split > .nos__photo :global(.photo-frame) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto !important;
    }
    /* 12 columnas: 4 valores (3 cols c/u) + 3 valores (4 cols c/u). */
    .nos__values {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .nos__values > li {
      grid-column: span 3;
    }
    .nos__values > li:nth-child(n + 5) {
      grid-column: span 4;
    }
    /* Foto vertical a la izquierda, Mision y Vision apiladas a la derecha. */
    .nos__mv {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-4) var(--space-8);
    }
    .nos__photo--tall {
      grid-column: 1;
      grid-row: 1 / span 2;
      max-width: none;
    }
    .nos__mision {
      grid-column: 2;
      grid-row: 1;
    }
    .nos__vision {
      grid-column: 2;
      grid-row: 2;
    }
    /* El hint "toca para ampliar" solo aplica en movil (a partir de 768 la grafica ya se lee). */
    .nos__dir-hint {
      display: none;
    }
    .nos__h1 {
      font-size: 44px;
      line-height: 52px;
    }
    .nos__h2 {
      font-size: 32px;
      line-height: 40px;
    }
  }
</style>
