---
import BaseLayout from '@layouts/BaseLayout.astro';
import TopBar from '@components/TopBar.astro';
import Drawer from '@components/Drawer.astro';
import Hero from '@components/Hero.astro';
import ComoFunciona from '@components/ComoFunciona.astro';
import Catalogo from '@components/Catalogo.astro';
import Galeria from '@components/Galeria.astro';
import Confianza from '@components/Confianza.astro';
import InfoImportante from '@components/InfoImportante.astro';
import Contacto from '@components/Contacto.astro';
import Footer from '@components/Footer.astro';
import Cotizador from '@islands/Cotizador/Cotizador';
---

<BaseLayout
  title="ALCUSA | Aluminio y vidrio en El Salvador"
  description="ALCUSA: ventanas, puertas y trabajos de aluminio y vidrio a la medida en El Salvador. Cotiza en línea y confirma por WhatsApp."
>
  <TopBar />
  <Drawer />

  <main>
    <Hero />
    <ComoFunciona />
    <Catalogo />
    <Galeria />
    <Confianza />

    <section id="cotizador" class="placeholder-section placeholder-section--cotizador">
      <h2 class="visually-hidden">Cotizador en línea</h2>
      <Cotizador client:load />
    </section>

    <InfoImportante />
    <Contacto />
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .placeholder-section {
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .placeholder-section--cotizador {
    padding: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
