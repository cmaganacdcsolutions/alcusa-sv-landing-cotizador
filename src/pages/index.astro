---
// Inicio = catalogo completo seccionado con configurador por producto
// (spec home-catalogo-completo §2; navbar fijo spec 01d). Sin islas React en el catalogo.
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import HomeIntro from '@components/home/HomeIntro.astro';
import CategoryTabs from '@components/home/CategoryTabs.astro';
import CatalogSection from '@components/home/CatalogSection.astro';
import ComoFunciona from '@components/ComoFunciona.astro';
import Promotions from '@components/Promotions.astro';
import Confianza from '@components/Confianza.astro';
import InfoImportante from '@components/InfoImportante.astro';
import ContactoTeaser from '@components/ContactoTeaser.astro';
import Footer from '@components/Footer.astro';
import { CATEGORIES, type CategorySlug } from '@content/catalog';
import { assertCatalogForBuild } from '@content/catalogBuild';

assertCatalogForBuild();

// Orden fijo del inicio: Puertas de baño, Puertas de jardín, Ventanas, Puertas abatibles (solo asesor).
const ORDER: readonly CategorySlug[] = ['puertas-de-bano', 'puertas-de-jardin', 'ventanas', 'puertas-abatibles'];
const sections = ORDER.map((slug) => CATEGORIES.find((c) => c.slug === slug)).filter(
  (c): c is (typeof CATEGORIES)[number] => !!c,
);
---

<BaseLayout
  title="ALCUSA | Aluminio y vidrio en El Salvador"
  description="ALCUSA: puertas de baño, puertas de jardín, ventanas y puertas abatibles de aluminio y vidrio a la medida en El Salvador. Elige tus opciones y cotiza en línea."
>
  <Navbar />

  <main id="main" tabindex="-1">
    <div class="home-top">
      <HomeIntro />
      <CategoryTabs />
      <div id="catalogo" class="home-catalogo">
        {sections.map((c, i) => <CatalogSection category={c} firstOfPage={i === 0} />)}
      </div>
    </div>
    <Promotions />
    <Confianza />
    <ComoFunciona />
    <InfoImportante />
    <ContactoTeaser />
  </main>

  <Footer />
</BaseLayout>

<script>
  import '@components/home/catalogHome.client';
</script>

<script is:inline>
  // Alias viejo: #modelos -> #catalogo (el resto de anclas viven en esta pagina).
  if (window.location.hash === '#modelos') {
    window.history.replaceState(null, '', '/#catalogo');
    document.getElementById('catalogo')?.scrollIntoView();
  }
</script>

<style is:global>
  /* El fondo (degradado azul noche continuo) y el texto base claro viven en global.css: son del sitio entero. */
  .home-top {
    padding-bottom: var(--space-12);
  }
</style>
