---
import BaseLayout from '@layouts/BaseLayout.astro';
import TopBar from '@components/TopBar.astro';
import Drawer from '@components/Drawer.astro';
import Hero from '@components/Hero.astro';
import ComoFunciona from '@components/ComoFunciona.astro';
import Catalogo from '@components/Catalogo.astro';
import Galeria from '@components/Galeria.astro';
import Confianza from '@components/Confianza.astro';
import CotizadorTeaser from '@components/CotizadorTeaser.astro';
import InfoImportante from '@components/InfoImportante.astro';
import ContactoTeaser from '@components/ContactoTeaser.astro';
import Footer from '@components/Footer.astro';
---

<BaseLayout
  title="ALCUSA | Aluminio y vidrio en El Salvador"
  description="ALCUSA: ventanas, puertas y trabajos de aluminio y vidrio a la medida en El Salvador. Cotiza en línea y confirma por WhatsApp."
>
  <TopBar />
  <Drawer />

  <main>
    <Hero />
    <ComoFunciona />
    <Catalogo />
    <Galeria />
    <Confianza />
    <CotizadorTeaser />
    <InfoImportante />
    <ContactoTeaser />
  </main>

  <Footer />
</BaseLayout>
