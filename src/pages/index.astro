---
import BaseLayout from '@layouts/BaseLayout.astro';
import TopBar from '@components/TopBar.astro';
import Drawer from '@components/Drawer.astro';
import Hero from '@components/Hero.astro';
import ComoFunciona from '@components/ComoFunciona.astro';
import Promotions from '@components/Promotions.astro';
import CatalogoCta from '@components/CatalogoCta.astro';
import Confianza from '@components/Confianza.astro';
// ContactoTeaser is rendered by InfoImportante — they share one <section
// id="info"> at desktop per desktop-01-inicio.dc.html (sf-fidelity3, spec
// item 4). Do not add a standalone <ContactoTeaser /> tag here.
import InfoImportante from '@components/InfoImportante.astro';
import Footer from '@components/Footer.astro';
---

<BaseLayout
  title="ALCUSA | Aluminio y vidrio en El Salvador"
  description="ALCUSA: ventanas, puertas y trabajos de aluminio y vidrio a la medida en El Salvador. Cotiza en línea y confirma por WhatsApp."
>
  <TopBar />
  <Drawer />

  <main>
    <Hero />
    <Promotions />
    <CatalogoCta />
    <ComoFunciona />
    <Confianza />
    <InfoImportante />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  // R3: el catalogo y la galeria salieron de la landing; los anclas viejas van a /catalogo.
  if (/^#(catalogo|galeria|modelos)$/.test(window.location.hash)) {
    window.location.replace('/catalogo');
  }
</script>
