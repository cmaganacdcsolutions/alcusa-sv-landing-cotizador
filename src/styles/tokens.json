{
  "color": {
    "bg": "#f6f3ed",
    "surface": "#ffffff",
    "surface-tint": "#eaf2ff",
    "ink": "#10213d",
    "ink-muted": "#445068",
    "muted": "#65738a",
    "border": "#dfe6ef",
    "border-input": "#cfd8e5",
    "primary": "#073b92",
    "accent": "#0956d8",
    "whatsapp": "#18a96b",
    "whatsapp-strong": "#087348",
    "whatsapp-strong-hover": "#06603c",
    "success": "#0d9b66",
    "error": "#d63232",
    "warning": "#8a5a00",
    "warning-bg": "#fff4e0",
    "focus": "#0956d8",
    "scrim-ink": "rgba(16,33,61,0.55)"
  },
  "font": {
    "family": {
      "display": "'Fraunces', Georgia, serif",
      "body": "'Manrope', system-ui, sans-serif"
    },
    "weight": {
      "display-regular": 400,
      "display-medium": 500,
      "display-semibold": 600,
      "body-regular": 400,
      "body-medium": 500,
      "body-bold": 700
    },
    "size": {
      "display-xl": { "mobile": "2.25rem", "desktop": "3.5rem" },
      "display-lg": { "mobile": "1.875rem", "desktop": "2.75rem" },
      "h1": { "mobile": "1.625rem", "desktop": "2.25rem" },
      "h2": { "mobile": "1.375rem", "desktop": "1.75rem" },
      "h3": { "mobile": "1.125rem", "desktop": "1.375rem" },
      "body-lg": { "mobile": "1.0625rem", "desktop": "1.125rem" },
      "body": { "mobile": "1rem", "desktop": "1rem" },
      "body-sm": { "mobile": "0.875rem", "desktop": "0.875rem" },
      "caption": { "mobile": "0.75rem", "desktop": "0.8125rem" }
    },
    "lineHeight": {
      "display": 1.15,
      "heading": 1.3,
      "body": 1.6
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "container": {
    "sm": "640px",
    "md": "840px",
    "lg": "1120px",
    "xl": "1320px",
    "page": "1600px"
  },
  "breakpoint": {
    "xs": "0px",
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "radius": {
    "xs": "6px",
    "sm": "10px",
    "md": "14px",
    "lg": "20px",
    "xl": "28px",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(16,33,61,0.06)",
    "sm": "0 2px 6px rgba(16,33,61,0.08)",
    "md": "0 8px 20px rgba(16,33,61,0.10)",
    "lg": "0 16px 40px rgba(16,33,61,0.12)",
    "focus": "0 0 0 3px rgba(9,86,216,0.35)"
  },
  "icon": {
    "strokeWidth": "1.5px",
    "grid": "24px",
    "minTapTarget": "44px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms",
      "slower": "480ms",
      "sweep": "1100ms"
    },
    "ease": {
      "ui": "cubic-bezier(.4,0,.2,1)",
      "glass": "cubic-bezier(.16,1,.3,1)",
      "sheen": "cubic-bezier(.65,0,.35,1)"
    },
    "reducedMotion": {
      "fallbackDuration": "150ms",
      "policy": "replace slide/sweep/scale transitions with opacity-only fades; freeze hero light-sweep to a static gradient"
    }
  }
}
