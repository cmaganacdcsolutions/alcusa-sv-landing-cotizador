---
import '@styles/global.css';
import '@styles/motion-transition.css';
// Unico archivo de la tipografia display que se precarga (latin, eje opsz): evita el salto de swap en el H1 sin
// sumar peso a la ruta critica. El resto de subconjuntos carga bajo demanda por unicode-range.
import { OG_IMAGE_PATH, SITE_NAME, absoluteUrl, canonicalPath, serializeJsonLd, siteUrl } from '../lib/seo';
import displayFontLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Paginas sin valor para buscadores (p. ej. borradores). */
  noindex?: boolean;
  /** Datos estructurados (schema.org) como bloque de datos, no script ejecutable. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const base = siteUrl();
const canonicalUrl = absoluteUrl(canonicalPath(Astro.url.pathname), base);
const ogImage = absoluteUrl(OG_IMAGE_PATH, base);
---

<!doctype html>
<html lang="es-SV">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0a1a33" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_SV" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Puertas y ventanas de aluminio y vidrio instaladas por Alcusa" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <script is:inline>
      // Motion 02 E5: solo home -> cotizador por navegacion nueva (no atras/adelante, no recarga), sin ?motion=off y sin reduce.
      (function () {
        const path = (u) => { try { return new URL(u).pathname.replace(/\/$/, '') || '/'; } catch { return ''; } };
        const off = () => /[?&]motion=off/.test(location.search) || matchMedia('(prefers-reduced-motion: reduce)').matches;
        addEventListener('pageswap', function (e) {
          const a = e.activation;
          if (e.viewTransition && !(a && a.entry && !off() && a.navigationType === 'push' && path(location.href) === '/' && path(a.entry.url) === '/cotizador')) e.viewTransition.skipTransition();
        });
        addEventListener('pagereveal', function (e) {
          const a = window.navigation && navigation.activation;
          if (e.viewTransition && !(a && a.from && !off() && a.navigationType === 'push' && path(a.from.url) === '/' && path(location.href) === '/cotizador')) e.viewTransition.skipTransition();
        });
      })();
    </script>
    <link rel="preload" href={displayFontLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
