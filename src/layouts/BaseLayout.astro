---
import '@styles/global.css';
import '@styles/motion-transition.css';
// Unico archivo de la tipografia display que se precarga (latin, eje opsz): evita el salto de swap en el H1 sin
// sumar peso a la ruta critica. El resto de subconjuntos carga bajo demanda por unicode-range.
import displayFontLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Paginas sin valor para buscadores (p. ej. borradores). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://alcusasv.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="es-SV">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0a1a33" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Motion 02 E5: solo home -> cotizador por navegacion nueva (no atras/adelante, no recarga), sin ?motion=off y sin reduce.
      (function () {
        var path = function (u) { try { return new URL(u).pathname.replace(/\/$/, '') || '/'; } catch (e) { return ''; } };
        var off = function () { return /[?&]motion=off/.test(location.search) || matchMedia('(prefers-reduced-motion: reduce)').matches; };
        addEventListener('pageswap', function (e) {
          var a = e.activation;
          if (e.viewTransition && !(a && a.entry && !off() && a.navigationType === 'push' && path(location.href) === '/' && path(a.entry.url) === '/cotizador')) e.viewTransition.skipTransition();
        });
        addEventListener('pagereveal', function (e) {
          var a = window.navigation && navigation.activation;
          if (e.viewTransition && !(a && a.from && !off() && a.navigationType === 'push' && path(a.from.url) === '/' && path(location.href) === '/cotizador')) e.viewTransition.skipTransition();
        });
      })();
    </script>
    <link rel="preload" href={displayFontLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
