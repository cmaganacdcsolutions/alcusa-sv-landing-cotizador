{
  "name": "alcusa-sv-landing-cotizador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "build": "astro build",
    "preview": "astro preview",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "server:build": "npm --prefix server run build",
    "pretest:e2e": "node scripts/build-e2e-fixtures.mjs",
    "test:e2e:http": "node scripts/build-e2e-http.mjs && playwright test --config=playwright.http.config.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:visual": "npm run test:e2e -- visual- --project=ios390 --project=desktop1920",
    "test:visual:update": "npm run test:e2e -- visual- --project=ios390 --project=desktop1920 --update-snapshots",
    "test:golden:update": "npm run test:e2e -- cotizador-golden --project=desktop1920 --update-snapshots",
    "verify": "node scripts/verify.mjs full",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:area": "node scripts/verify.mjs area",
    "verify:suggest": "node scripts/suggest-areas.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.3.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "astro-eslint-parser": "3.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
